__pycache__/
*.pyc
.venv/
venv/
.env
*.env
!*.env.example
.idea/
.vscode/
*.log
.DS_Store
/dist/
/build/
# Go build outputs in any module: test binaries (go test -c), profiles, coverage, delve's binary.
# Binaries are built into /build/ (go build -o); a module whose own build drops them anywhere else
# ignores them in its own .gitignore, so no component's binary names are listed here.
*.test
*.prof
coverage.out
__debug_bin*
# per-run private output (homelabnext/runs.py; HNX_RUNS_DIR moves it)
/runs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
*.tfstate
*.tfstate.*
.terraform/
secrets/
!/conformance/secrets/
*.pem
*.key
*.egg-info/
/homelabnext/_data/
.coverage
.coverage.*
# Obsidian vault settings (docs/ opens as a vault; see docs/README.md)
.obsidian/

# the knowledge graph is a local build (hnx graph build): any change would make a committed copy stale
docs/graph/
