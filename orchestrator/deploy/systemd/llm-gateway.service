# SPDX-License-Identifier: Apache-2.0
# EXAMPLE ONLY: not installed or referenced by any deploy, and naming no host (docs/gateway.md).
#
# The LLM gateway (ADR-0038): a system unit, run as a dynamic user with no
# write access anywhere but its usage directory. TLS is terminated at the lab's edge, so it
# listens on loopback; to listen on a lab address, add -tls-cert/-tls-key (or, behind the edge on a
# trusted segment, -allow-plaintext, which puts bearer tokens and prompts in clear there).
#
# /etc/llm-gateway/gateway.json   rendered by `hnx gen gateway render` (no secret values)
# /etc/llm-gateway/secrets.env    HNX_SECRET_*=... for every *_env the config names, mode 0600
#                                 root:root (systemd reads it before dropping privileges)
[Unit]
Description=LLM gateway (role aliases in front of the model backends)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/llm-gateway/secrets.env
ExecStartPre=/usr/local/bin/gateway -config /etc/llm-gateway/gateway.json -check
ExecStart=/usr/local/bin/gateway -config /etc/llm-gateway/gateway.json -listen 127.0.0.1:4100 -usage /var/lib/llm-gateway/usage.jsonl
Restart=on-failure
RestartSec=5
# SIGTERM drains in-flight calls for up to -upstream-timeout (120 s) + 5 s
TimeoutStopSec=130

DynamicUser=yes
StateDirectory=llm-gateway
StateDirectoryMode=0700
UMask=0077
ReadWritePaths=/var/lib/llm-gateway
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# no proxy for upstream calls unless -upstream-proxy is given; the gateway ignores these anyway
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY NO_PROXY

[Install]
WantedBy=multi-user.target
