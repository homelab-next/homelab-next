# Managed by homelabnext (role rkhunter, control rootkit-check); local changes are overwritten.
[Unit]
Description=homelabnext rkhunter rootkit check (control rootkit-check)

[Service]
Type=oneshot
# the job's last-run record (role last_run), written on start and again on stop, whatever
# the outcome; a writer problem never changes the job's own result (the - prefix)
ExecStartPre=-/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ rkhunter_last_run_dir }} --group {{ rkhunter_last_run_group }} --job timer:rkhunter/scan --unit %n --calendar "{{ rkhunter_schedule }}" --delay 900
ExecStart=/usr/local/libexec/homelabnext/rkhunter-scan
Nice=10
IOSchedulingClass=idle
ExecStopPost=-/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ rkhunter_last_run_dir }} --group {{ rkhunter_last_run_group }} --job timer:rkhunter/scan --unit %n --calendar "{{ rkhunter_schedule }}" --delay 900
