# Managed by homelabnext (role compose_app); local changes are overwritten.
[Unit]
Description=Database dump of {{ compose_app_name }}, nightly, before the guest's image backup

[Timer]
OnCalendar={{ compose_app_export_calendar }}
RandomizedDelaySec={{ compose_app_export_delay_s }}
Persistent=true

[Install]
WantedBy=timers.target
