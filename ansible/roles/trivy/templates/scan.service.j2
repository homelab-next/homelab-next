# Managed by homelabnext (role trivy, control package-scan); local changes are overwritten.
[Unit]
Description=homelabnext Trivy package scan (control package-scan)

[Service]
Type=oneshot
# the job's last-run record (role last_run), written on start and again on stop, whatever
# the outcome; a writer problem never changes the job's own result (the - prefix)
ExecStartPre=-/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ trivy_last_run_dir }} --group {{ trivy_last_run_group }} --job timer:trivy/scan --unit %n --calendar "{{ trivy_schedule }}" --delay 900
ExecStart=/usr/local/libexec/homelabnext/trivy-scan
Nice=10
IOSchedulingClass=idle
ExecStopPost=-/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ trivy_last_run_dir }} --group {{ trivy_last_run_group }} --job timer:trivy/scan --unit %n --calendar "{{ trivy_schedule }}" --delay 900
