# Managed by Ansible (role example_service). Do not edit.
service_id: {{ example_service_logical_id }}
version: {{ example_service_version }}
listen_port: {{ example_service_listen_port }}
data_dir: {{ example_service_data_dir }}
dependencies:
{% for dep in example_service_dependencies %}
