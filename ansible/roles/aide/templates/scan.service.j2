# Managed by homelabnext (role aide, control file-integrity); local changes are overwritten.
[Unit]
Description=homelabnext AIDE file integrity check (control file-integrity)

[Service]
Type=oneshot
# the job's last-run record (role last_run), written on start and again on stop, whatever
# the outcome; a writer problem never changes the job's own result (the - prefix)
ExecStartPre=-/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ aide_last_run_dir }} --group {{ aide_last_run_group }} --job timer:aide/scan --unit %n --calendar "{{ aide_schedule }}" --delay 900
ExecStart=/usr/local/libexec/homelabnext/aide-scan
Nice=10
IOSchedulingClass=idle
ExecStopPost=-/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ aide_last_run_dir }} --group {{ aide_last_run_group }} --job timer:aide/scan --unit %n --calendar "{{ aide_schedule }}" --delay 900
