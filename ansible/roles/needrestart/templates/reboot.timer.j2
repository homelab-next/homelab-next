# Managed by homelabnext (role needrestart, control restart-required); local changes are overwritten.
[Unit]
Description=homelabnext pending-reboot check (control restart-required)

[Timer]
OnCalendar={{ needrestart_reboot_schedule }}
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
