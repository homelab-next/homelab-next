#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# hnx-script:
#   id: needrestart-check
#   kind: job
#   purpose: List what needs a restart (needrestart -b, never restarting anything) and alert when that set changes.
#   owner: platform
#   trigger: [timer:needrestart/check, role:needrestart]
#   inputs: needrestart -b batch output; the previous state file
#   outputs: the state file (owner-only) and, on a change, one alert (ntfy or local mail)
#   installs_to: /usr/local/libexec/homelabnext/needrestart-check
#   exit:
#     "0": checked (and alerted, if the set changed)
#     "1": needrestart failed; the state file is not rewritten (or, with --test, the channel did not deliver)
#     "2": the alert could not be sent; it stays owed to the next run
"""Managed by homelabnext (role needrestart, control restart-required); local changes are
overwritten.  `needrestart -b` lists, it never restarts: NEEDRESTART-KSTA (1 current, 2 or 3 a
newer kernel waits for a reboot), NEEDRESTART-KCUR, NEEDRESTART-KEXP and one NEEDRESTART-SVC line
per service.  The state file keeps the last check and the last set an alert was sent for; an alert
goes out only when the set differs from that one (state-diffed), so an unchanged set is silent and
a failed alert is retried on the next run."""

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

STATE_DIR = {{ needrestart_state_dir | to_json }}
NEEDRESTART = {{ needrestart_cli | to_json }}
MODE = {{ needrestart_mode | to_json }}
ALERT_KERNEL = {{ 'True' if needrestart_alert_kernel | bool else 'False' }}
NOTIFY_URL = {{ needrestart_notify_url | to_json }}
TOPIC = {{ needrestart_notify_topic | to_json }}
PRIORITY = {{ needrestart_notify_priority | int }}
TOKEN_FILE = {{ (needrestart_notify_auth_file if needrestart_notify_auth_ref else '') | to_json }}
SENDMAIL = {{ needrestart_sendmail_cli | to_json }}
MAIL_TO = {{ needrestart_mail_to | to_json }}
STATE = os.path.join(STATE_DIR, "state.json")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Follow no redirect: the 3xx is the HTTPError.  urllib's stock handler resends a POST
    answered 301/302/303 as a GET with no body, to any origin, and copies the Authorization
    header along with it."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


# the alert carries the access token.  The role refuses a token over plain http unless
# needrestart_notify_allow_plain_http opts in (a LAN endpoint with no TLS); as
# defence in depth the post follows no redirect and takes no proxy from the environment
# (HTTP(S)_PROXY would be handed the request)
OPENER = urllib.request.build_opener(_NoRedirect, urllib.request.ProxyHandler({}))

SEND_STATUS = os.path.join(STATE_DIR, "send-status.json")
_SECRETS = []  # the token, once read: scrubbed from any error text that is printed or recorded


def describe(exc):
    """The failure in one line and never the token: an HTTP status is named, anything else is its
    class and message, bounded and scrubbed."""
    if isinstance(exc, urllib.error.HTTPError):
        text = f"HTTP {exc.code} from the notify endpoint"
    else:
        text = f"{type(exc).__name__}: {exc}"
    for secret in _SECRETS:
        text = text.replace(secret, "[token]")
    return " ".join(text.split())[:200]


def record(error=None):
    """The last send attempt (time, ok, error) beside the state: the role's health fails when it
    failed.  A state directory that cannot be written is not a second failure."""
    doc = {"time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "ok": error is None, "error": error or ""}
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        tmp = SEND_STATUS + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(doc, fh, sort_keys=True)
        os.replace(tmp, SEND_STATUS)
    except OSError:
        pass


def parse(text):
    svcs, k = [], {}
    for line in text.splitlines():
        key, _, value = line.partition(":")
        value = value.strip()
        if key == "NEEDRESTART-SVC" and value:
            svcs.append(value)
        elif key in ("NEEDRESTART-KSTA", "NEEDRESTART-KCUR", "NEEDRESTART-KEXP"):
            k[key[12:].lower()] = value
    pending = k.get("ksta") in ("2", "3")
    kernel = {"status": k.get("ksta", ""), "current": k.get("kcur", ""),
              "expected": k.get("kexp", ""), "reboot_pending": pending}
    return sorted(set(svcs)), kernel


def alert_set(services, kernel):
    return {"services": services, "kernel": kernel["expected"] if ALERT_KERNEL and kernel["reboot_pending"] else ""}


def message(s):
    if not s["services"] and not s["kernel"]:
        return "restart-required: nothing needs a restart now", "No service (or kernel) waits for a restart any more."
    lines = [f"- {x}" for x in s["services"]]
    if s["kernel"]:
        lines.append(f"- reboot into kernel {s['kernel']}")
    title = f"restart-required: {len(s['services'])} service(s){' and a kernel' if s['kernel'] else ''}"
    return title, "Restart needed (needrestart lists only; nothing was restarted):\n" + "\n".join(lines)


def _deliver(title, body, priority=None):
    host = os.uname().nodename
    if MODE == "notify":
        headers = {"Title": f"{host}: {title}", "Priority": str(priority or PRIORITY),
                   "Tags": "homelabnext,restart-required", "Content-Type": "text/plain; charset=utf-8"}
        if TOKEN_FILE:
            with open(TOKEN_FILE, encoding="utf-8") as fh:
                token = fh.read().strip()
            if not token:
                raise ValueError(f"the token file {TOKEN_FILE} is empty")
            if not (token.isascii() and token.isprintable()):
                # never quoted: http.client's own refusal would print the whole header value
                raise ValueError(f"the token in {TOKEN_FILE} is not printable ASCII")
            _SECRETS.append(token)
            headers["Authorization"] = "Bearer " + token
        req = urllib.request.Request(f"{NOTIFY_URL}/{TOPIC}", data=body.encode("utf-8"), headers=headers, method="POST")
        with OPENER.open(req, timeout=10) as resp:
            resp.read()
            if not 200 <= resp.status < 300:
                raise ValueError(f"the notify endpoint answered HTTP {resp.status}")
    elif MODE == "mail":
        mail = f"To: {MAIL_TO}\nSubject: {host}: {title}\n\n{body}\n"
        subprocess.run([SENDMAIL, "-t"], input=mail, text=True, check=True)


def send(title, body, priority=None):
    """Deliver one alert and record the outcome (the last attempt, for health)."""
    try:
        _deliver(title, body, priority)
    except Exception as exc:
        record(describe(exc))
        raise
    record()


def run_test():
    """`--test`: one low-priority message through exactly the path a real alert takes.  Exits 0
    when the channel delivered, 1 with the error (never the token) when it did not."""
    host = os.uname().nodename
    if MODE == "none":
        print("no alert channel is configured (notify none): nothing to test")
        return 0
    text = f"needrestart channel test from {host}"
    try:
        send(text, text, priority=1)
    except Exception as exc:
        print(f"channel test failed: {describe(exc)}", file=sys.stderr)
        return 1
    print(f"channel test ok: {text}")
    return 0


def main():
    if "--test" in sys.argv[1:]:
        return run_test()
    run = subprocess.run([NEEDRESTART, "-b"], capture_output=True, text=True)
    if run.returncode != 0:
        print(f"needrestart -b exited {run.returncode}: {run.stderr.strip()}", file=sys.stderr)
        return 1
    services, kernel = parse(run.stdout)
    try:
        with open(STATE, encoding="utf-8") as fh:
            prev = json.load(fh)
    except (OSError, ValueError):
        prev = {}
    now = alert_set(services, kernel)
    alerted = prev.get("alerted", {"services": [], "kernel": ""})
    rc = 0
    if now != alerted and MODE != "none":
        try:
            send(*message(now))
            alerted = now
        except Exception as exc:  # the alert stays owed
            print(f"alert not sent: {exc}", file=sys.stderr)
            rc = 2
    elif MODE == "none":
        alerted = now
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = STATE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"services": services, "kernel": kernel, "alerted": alerted}, fh, indent=2, sort_keys=True)
    os.replace(tmp, STATE)
    return rc


if __name__ == "__main__":
    sys.exit(main())
