# Managed by Ansible (role openbao). Do not edit.
# SIGHUP makes the server reopen its audit file; the rotated files stay mode 0600, owned by the
# service account.
{{ openbao_audit_file }} {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0600 {{ openbao_user }} {{ openbao_group }}
    postrotate
        {{ openbao_systemctl_cli }} kill --signal=HUP --kill-whom=main {{ openbao_service }}.service >/dev/null 2>&1 || true
    endscript
}
