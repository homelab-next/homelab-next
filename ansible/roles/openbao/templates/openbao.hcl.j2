# Managed by Ansible (role openbao) for {{ openbao_logical_id }}. Do not edit.
# Server mode: integrated (raft) storage, single node (no retry_join), TLS on the listener, two
# audit devices (a file and syslog). Initialising
# and unsealing are the operator's (ADR-0042 decision 6); nothing here holds a key or a token.
# Every string is written JSON-quoted, which HCL reads as the same string.
ui = {{ openbao_ui | bool | to_json }}
log_level = {{ openbao_log_level | to_json }}
api_addr = {{ openbao_api_addr | to_json }}
cluster_addr = {{ openbao_cluster_url | to_json }}

storage "raft" {
  path = {{ openbao_data_dir | to_json }}
  node_id = {{ openbao_node_id | to_json }}
}

listener "tcp" {
  address = {{ (openbao_listen_address_hostport ~ ':' ~ (openbao_port | int)) | to_json }}
  cluster_address = {{ (openbao_listen_address_hostport ~ ':' ~ (openbao_cluster_port | int)) | to_json }}
  tls_cert_file = {{ openbao_tls_cert_file | to_json }}
  tls_key_file = {{ openbao_tls_key_file | to_json }}
  tls_min_version = {{ openbao_tls_min_protocol | to_json }}
  # TLS 1.2: forward-secret AEAD suites only (TLS 1.3 suites are AEAD and not configurable).
  tls_cipher_suites = {{ openbao_tls_cipher_suites | join(',') | to_json }}
}

# Every request and response, HMAC'd, to a file only the service account reads, and to syslog
# (the journal, and from there the log pipeline). Declared here, so they exist from the first
# unseal and the API cannot remove them. With two devices a request is served while at least one
# of them records it: a full or broken audit disk alone does not stop the store.
audit "file" "file" {
  description = "file audit device (role openbao)"
  options {
    file_path = {{ openbao_audit_file | to_json }}
    mode = "0600"
  }
}

audit "syslog" "syslog" {
  description = "syslog audit device (role openbao)"
  options {
    facility = "AUTH"
    tag = {{ openbao_service | to_json }}
  }
}
