# Managed by homelabnext (role hardware_metrics, control hardware-metrics); local changes are overwritten.
[Unit]
Description=homelabnext hardware metrics (control hardware-metrics)

[Service]
Type=oneshot
# the job's last-run record (role last_run), written on start and again on stop, whatever
# the outcome; a writer problem never changes the job's own result (the - prefix)
ExecStartPre=-/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ hardware_metrics_last_run_dir }} --group {{ hardware_metrics_last_run_group }} --job timer:hardware_metrics/{{ hardware_metrics_unit }} --unit %n --calendar "{{ hardware_metrics_interval }}" --delay 0
ExecStart=/usr/local/libexec/homelabnext/hnx-hardware-metrics --config {{ hardware_metrics_config }}
ExecStopPost=-/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ hardware_metrics_last_run_dir }} --group {{ hardware_metrics_last_run_group }} --job timer:hardware_metrics/{{ hardware_metrics_unit }} --unit %n --calendar "{{ hardware_metrics_interval }}" --delay 0
Nice=10
TimeoutStartSec=120
# read-only everywhere but the metrics file's directory and the last-run record; the board
# collector needs the controller's device node, so devices stay visible
ProtectSystem=strict
ReadWritePaths={{ hardware_metrics_textfile_dir }} {{ hardware_metrics_last_run_dir }}
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
