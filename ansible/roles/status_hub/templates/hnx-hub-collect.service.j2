# Managed by homelabnext (role status_hub, service {{ status_hub_logical_id }}); local changes are overwritten.
# One collection pass over the registered status sources (ADR-0013, docs/status.md section 2): the
# hub only reads state.json, so a source that stops being collected reads stale at the page.
[Unit]
Description=homelab-next status hub: one collection pass ({{ status_hub_logical_id }})
After=network-online.target

[Service]
Type=oneshot
User={{ status_hub_user }}
Group={{ status_hub_group }}
WorkingDirectory={{ status_hub_state_dir }}
ExecStart={{ status_hub_hnx_bin }} status collect --registry {{ status_hub_config_dir }}/services.yml --state {{ status_hub_state_dir }}/state.json --root {{ status_hub_root_dir }} --secrets-dir {{ status_hub_issued_dir }}{% if status_hub_notify_topic | length > 0 %} --notify-topic {{ status_hub_notify_topic }} --notify-ceiling {{ status_hub_notify_ceiling }}{% endif %}

{% for cap, url in status_hub_endpoints | dictsort %}
Environment=HNX_ENDPOINT_{{ cap | upper | replace('-', '_') }}={{ url }}
{% endfor %}
{% if status_hub_ca_bundle | bool %}
Environment=SSL_CERT_FILE={{ status_hub_ca_bundle_path }}
{% endif %}
EnvironmentFile=-{{ status_hub_config_dir }}/secrets.env
TimeoutStartSec={{ status_hub_collect_timeout_s | int }}
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths={{ status_hub_state_dir }}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
