# Managed by homelabnext (role status_hub); local changes are overwritten.
# Refreshes the login-issued bearer tokens the collector sends (docs/status.md, "Login-issued tokens").
[Unit]
Description=homelab-next status hub: refresh login-issued tokens ({{ status_hub_logical_id }})
After=network-online.target

[Service]
Type=oneshot
# the job's last-run record (role last_run), written on start and again on stop, whatever
# the outcome; a writer problem never changes the job's own result (the - prefix; the + runs the
# writer privileged, outside this unit's User= and sandbox, as the record directory is root's)
ExecStartPre=-+/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ status_hub_last_run_dir }} --group {{ status_hub_last_run_group }} --job timer:status_hub/hnx-hub-login-token --unit %n --calendar "{{ status_hub_logins_oncalendar }}" --delay 60
ExecStart=/usr/bin/python3 -I /usr/local/libexec/hnx-hub/hnx-hub-login-token --config {{ status_hub_config_dir }}/login-tokens.json
TimeoutStartSec=120
ExecStopPost=-+/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ status_hub_last_run_dir }} --group {{ status_hub_last_run_group }} --job timer:status_hub/hnx-hub-login-token --unit %n --calendar "{{ status_hub_logins_oncalendar }}" --delay 60
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ status_hub_issued_dir }}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
