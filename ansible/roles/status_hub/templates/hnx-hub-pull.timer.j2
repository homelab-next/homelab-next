# Managed by homelabnext (role status_hub); local changes are overwritten.
[Unit]
Description=homelab-next status hub: pull schedule ({{ status_hub_logical_id }})

[Timer]
OnCalendar={{ status_hub_pulls_oncalendar }}
AccuracySec=1s
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
