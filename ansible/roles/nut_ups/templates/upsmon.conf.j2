# Managed by homelabnext (role nut_ups, control ups-protection); local changes are overwritten.
# This host owns the UPS cable, so it is the primary and its monitor shuts it down: a clean, ordered
# stop (the hypervisor stops the guests on host shutdown). MINSUPPLIES 1: one UPS powers this host.
MONITOR {{ nut_ups_name }}@localhost 1 {{ nut_ups_monitor_user }} {{ nut_ups_pw.content | b64decode | trim }} primary
MINSUPPLIES 1
SHUTDOWNCMD "{{ nut_ups_shutdown_cmd }}"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
{% if nut_ups_cut_power | bool %}
POWERDOWNFLAG /etc/killpower
{% else %}
POWERDOWNFLAG /run/nut/hnx-no-killpower
{% endif %}
RBWARNTIME 43200
NOCOMMWARNTIME 300
FINALDELAY 5
NOTIFYFLAG ONLINE SYSLOG
NOTIFYFLAG ONBATT SYSLOG+WALL
NOTIFYFLAG LOWBATT SYSLOG+WALL
NOTIFYFLAG FSD SYSLOG+WALL
NOTIFYFLAG COMMOK SYSLOG
NOTIFYFLAG COMMBAD SYSLOG
NOTIFYFLAG SHUTDOWN SYSLOG+WALL
NOTIFYFLAG NOCOMM SYSLOG
