{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/platform/agent_profile/1.2",
  "title": "Agent profile (compiled)",
  "description": "The compiled, least-privilege profile for one agent. mcp must be a subset of mcp_ceiling (checked by tools/schema_check.py check_profile_ceiling). Model is a role alias, never a model id. Budgets are hard caps; context is referenced by logical id. 1.1 declares reads_untrusted (additive, optional, boolean; absent means true): a ceiling policy that marks the profile a reader overrides false (hnx mcp catalog render refuses it). 1.2 adds tlp_ceiling (additive, optional; ADR-0033 decision 12): the profile's TLP ceiling as the ceiling policy attests it, agreeing with data_tier; absent, it is read from data_tier.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "persona": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/persona_id"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/skill_id"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
      },
      "uniqueItems": true
    },
    "model_role": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/mdl_id"
    },
    "mcp": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "uniqueItems": true
    },
    "mcp_ceiling": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "uniqueItems": true
    },
    "memory_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "data_tier": {
      "enum": [
        "local-only",
        "cloud-allowed"
      ]
    },
    "tlp_ceiling": {
      "enum": [
        "clear",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "description": "The profile's TLP ceiling, attested by the ceiling policy (ADR-0033 decision 12); agrees with data_tier (local-only is above clear, cloud-allowed is clear)."
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_runtime_s",
        "max_tool_calls"
      ]
    },
    "reads_untrusted": {
      "type": "boolean",
      "description": "The profile reads raw or untrusted content. Absent means true; a ceiling policy that marks the profile a reader overrides false."
    },
    "digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "persona",
    "model_role",
    "mcp",
    "mcp_ceiling",
    "data_tier",
    "budgets"
  ]
}
