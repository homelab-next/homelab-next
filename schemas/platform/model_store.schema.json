{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/platform/model_store/1.0",
  "title": "Model store manifest",
  "description": "The one model store (ADR-0023): every model the lab keeps on disk, once per (source, revision, quant), under one root. format hf is a Hugging Face safetensors snapshot in the hub cache layout (hf/hub/models--<org>--<name>/snapshots/<revision>/), gguf one single-file GGUF under gguf/<org>/<name>/, export a fine-tune export under exports/<run>/ (layout safetensors or gguf, with the base entry it was trained from). source.revision is a full 40-hex commit, never a branch. Every file carries its sha256 and size; an entry's digest is sha256 of its sha256sum listing, the value a model-role binding pins. engines lists who may serve it: vllm serves safetensors only, llama-server GGUF only, unsloth-studio either. Semantic rules JSON Schema cannot express (one copy per source+revision+quant, export base resolves, exactly one .gguf per GGUF entry, bindings resolve) are checked by homelabnext.models.store (`hnx models store validate`).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "models"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "root": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/-]*$",
      "description": "The store root on the serving host (default /srv/models)."
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "description": "Relative to the entry's directory."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hub_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The pinned commit. A branch or tag (main) is refused: it is a different model tomorrow."
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "quant",
        "source",
        "license",
        "served_model_name",
        "engines",
        "files"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "format": {
          "enum": [
            "hf",
            "gguf",
            "export"
          ]
        },
        "layout": {
          "enum": [
            "safetensors",
            "gguf"
          ]
        },
        "quant": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,31}$"
        },
        "source": {
          "type": "object"
        },
        "base": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
        },
        "license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "served_model_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "description": "The id an engine serves it under: a role binding's model_id."
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "vllm",
              "llama-server",
              "unsloth-studio"
            ]
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "export"
              }
            }
          },
          "then": {
            "required": [
              "layout",
              "base"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run"
                ],
                "properties": {
                  "run": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "base"
              ]
            },
            "properties": {
              "source": {
                "$ref": "#/$defs/hub_source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "hf"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "const": "safetensors"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "gguf"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "const": "gguf"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "format": {
                    "const": "gguf"
                  }
                },
                "required": [
                  "format"
                ]
              },
              {
                "properties": {
                  "layout": {
                    "const": "gguf"
                  }
                },
                "required": [
                  "layout"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "engines": {
                "items": {
                  "not": {
                    "const": "vllm"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "format": {
                    "const": "hf"
                  }
                },
                "required": [
                  "format"
                ]
              },
              {
                "properties": {
                  "layout": {
                    "const": "safetensors"
                  }
                },
                "required": [
                  "layout"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "engines": {
                "items": {
                  "not": {
                    "const": "llama-server"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
