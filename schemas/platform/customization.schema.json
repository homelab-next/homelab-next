{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/platform/customization/1.2",
  "title": "Customization",
  "description": "One lab- or vendor-specific deviation from the core, held outside the core so it is visible, owned and expiring. A customization can only use a sanctioned extension point (variable override, role hook, template overlay, registry patch, opt-in host profile); it can never edit core files or bypass a schema.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^custom:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100,
      "not": { "pattern": "[0-9]{4,}" },
      "description": "Logical id, custom:<slug>."
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "kind": {
      "enum": ["profile", "override", "hook", "patch-overlay", "registry-patch"],
      "description": "Which sanctioned extension point family this uses. Selects the shape of action."
    },
    "scope": {
      "type": "object",
      "description": "Where it applies. At least one selector. Selectors use logical ids and names, never addresses.",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "services": {
          "type": "array",
          "items": { "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/svc_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/role_name" },
          "minItems": 1,
          "uniqueItems": true
        },
        "hosts": {
          "type": "array",
          "items": { "$ref": "#/$defs/host_name" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "contract": {
      "type": "string",
      "pattern": "^(?:cap:[a-z][a-z0-9]*(?:-[a-z0-9]+)*|adr:[a-z][a-z0-9]*(?:-[a-z0-9]+)*|https://schemas\\.example\\.internal/homelabnext/[a-z0-9_./-]+/[0-9]+\\.[0-9]+)$",
      "description": "The contract this deviates from: a capability id, an ADR slug (adr:<slug>) or a schema $id."
    },
    "reason": {
      "type": "string",
      "minLength": 20,
      "description": "Human text: why the core cannot or should not do this. A label is not a reason."
    },
    "owner": { "type": "string", "minLength": 2, "maxLength": 80 },
    "created": { "$ref": "#/$defs/date" },
    "review_by": {
      "$ref": "#/$defs/date",
      "description": "Required unless maintained_upstream is true. After this date the customization is expired and the invariant fails until it is renewed, upstreamed or retired."
    },
    "maintained_upstream": {
      "type": "boolean",
      "default": false,
      "description": "Schema 1.1. True for a profile shipped and maintained by the project itself: exempt from the review_by expiry rule. Honoured only for documents loaded from the project's own shipped profiles directory; the linter rejects it (CU015) in any user overlay, so it cannot be forged by a file."
    },
    "links": {
      "type": "object",
      "properties": {
        "lesson": {
          "anyOf": [
            { "type": "string", "pattern": "^LL-[0-9]{3,}$" },
            { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?!\\n)" }
          ],
          "description": "1.2: the lesson's uid (ADR-0019); a legacy numbered code still validates and resolves through examples/registers/aliases.yml to that uid, with one deprecation warning naming it (hnx custom check CU017, hnx graph build); a code aliases.yml does not hold, or lists as retired, is an error (CU016; a dangling graph edge). hnx records assign-uids rewrites it as the uid."
        },
        "runbook": {
          "anyOf": [
            { "type": "string", "pattern": "^RB-[0-9]{3,}$" },
            { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?!\\n)" }
          ],
          "description": "1.2: the runbook's uid, as for lesson."
        }
      },
      "additionalProperties": false
    },
    "upstream": {
      "enum": ["none", "proposed", "accepted"],
      "description": "Whether the fix has been offered back: none, proposed (PR or issue open), accepted (merged; retire after upgrading)."
    },
    "upstream_ref": { "type": "string", "minLength": 3, "maxLength": 200 },
    "optional": {
      "type": "boolean",
      "default": false,
      "description": "True for shipped opt-in profiles: inert until a deployment enables the id (optionally for named hosts)."
    },
    "action": { "type": "object" }
  },
  "required": ["id", "title", "kind", "scope", "contract", "reason", "owner", "created", "upstream", "action"],
  "anyOf": [
    { "required": ["review_by"] },
    { "required": ["maintained_upstream"], "properties": { "maintained_upstream": { "const": true } } }
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "override" } }, "required": ["kind"] },
      "then": { "properties": { "action": { "$ref": "#/$defs/override_action" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "hook" } }, "required": ["kind"] },
      "then": { "properties": { "action": { "$ref": "#/$defs/hook_action" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "patch-overlay" } }, "required": ["kind"] },
      "then": { "properties": { "action": { "$ref": "#/$defs/patch_overlay_action" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "registry-patch" } }, "required": ["kind"] },
      "then": { "properties": { "action": { "$ref": "#/$defs/registry_patch_action" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "profile" } }, "required": ["kind"] },
      "then": { "properties": { "action": { "$ref": "#/$defs/profile_action" } } }
    }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "role_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "host_name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "var_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 96 },
    "rel_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
      "not": { "pattern": "\\.\\." },
      "maxLength": 200,
      "description": "Relative to the customization's own directory; never absolute, never parent-relative."
    },
    "override_action": {
      "type": "object",
      "description": "Ansible variable overrides for one role. Every variable carries the role prefix and must already exist in the role defaults.",
      "properties": {
        "role": { "$ref": "#/$defs/role_name" },
        "vars": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/var_name" },
          "minProperties": 1
        }
      },
      "required": ["role", "vars"],
      "additionalProperties": false
    },
    "hook_action": {
      "type": "object",
      "description": "A pre or post task hook around one role entry point (docs/role-interface.md).",
      "properties": {
        "role": { "$ref": "#/$defs/role_name" },
        "entry_point": { "enum": ["main", "health", "readiness", "backup", "restore", "upgrade", "export"] },
        "phase": { "enum": ["pre", "post"] },
        "tasks_file": { "$ref": "#/$defs/rel_path" }
      },
      "required": ["role", "entry_point", "phase", "tasks_file"],
      "additionalProperties": false
    },
    "patch_overlay_action": {
      "type": "object",
      "description": "A template overlay for a role template, addressed by name. The core template is never edited; the overlay is composed at render time.",
      "properties": {
        "role": { "$ref": "#/$defs/role_name" },
        "template": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.j2$", "maxLength": 100 },
        "overlay": { "$ref": "#/$defs/rel_path" },
        "mode": { "enum": ["append", "prepend", "replace"] }
      },
      "required": ["role", "template", "overlay", "mode"],
      "additionalProperties": false
    },
    "registry_patch_action": {
      "type": "object",
      "description": "Field changes on one registry service row. The patched registry must still validate against the service schema.",
      "properties": {
        "service": { "$ref": "#/$defs/slug" },
        "set": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/var_name" },
          "minProperties": 1
        }
      },
      "required": ["service", "set"],
      "additionalProperties": false
    },
    "profile_action": {
      "type": "object",
      "description": "An opt-in host profile: named extra tasks a host runs only when the profile is enabled for it.",
      "properties": {
        "profile": { "$ref": "#/$defs/slug" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 3, "maxLength": 100 },
              "file": { "$ref": "#/$defs/rel_path" }
            },
            "required": ["name", "file"],
            "additionalProperties": false
          }
        },
        "vars": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/var_name" }
        }
      },
      "required": ["profile", "tasks"],
      "additionalProperties": false
    }
  }
}
