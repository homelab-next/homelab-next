{
  "action": "host.restart-service",
  "description": "Move approved notes to completed",
  "tier": "privileged",
  "mode": "shadow",
  "requires_approval": true,
  "target": "svc:records",
  "handler": "handlers/records_complete.py",
  "params": {
    "type": "object",
    "properties": {
      "related": {
        "type": "array"
      }
    }
  },
  "timeout_s": 30,
  "idempotent": true,
  "audit": true
}
