{
  "id": "proposal-triage",
  "version": 1,
  "question_set": [
    "Does the proposal name a rollback?"
  ],
  "decision_table": [
    {
      "when": "rollback present",
      "then": "accept"
    },
    {
      "when": "otherwise",
      "then": "escalate"
    }
  ],
  "tiers": [
    {
      "name": "floor"
    },
    {
      "name": "small",
      "model_role": "mdl:fast-classifier",
      "min_confidence": 0.8
    }
  ],
  "error_direction": "fail-closed",
  "on_error": "accept",
  "latency_budget_ms": 5000,
  "sample_audit_pct": 10
}
