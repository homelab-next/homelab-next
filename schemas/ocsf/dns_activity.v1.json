{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/ocsf/dns_activity/1.1",
  "title": "DNS Activity",
  "description": "Pinned subset of the OCSF DNS Activity class (OCSF 1.3.0, class_uid 4003) as stored in the lake. Flat top-level columns plus a few one-level structs; the lake table, Arrow schema and DDL are generated from this file (see homelabnext/lake).",
  "x-lake": {
    "table": "dns_activity",
    "ocsf_class": "dns_activity",
    "ocsf_class_uid": 4003,
    "ocsf_version": "1.3.0",
    "key": [
      "uid"
    ],
    "time_column": "time",
    "partition": "day(time)"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid",
    "time",
    "class_uid",
    "category_uid",
    "activity_id",
    "severity_id",
    "query_hostname"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable content-derived event id. This is the idempotency (content) key of the table."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "Event time, RFC 3339 with an explicit offset; stored as UTC."
    },
    "class_uid": {
      "const": 4003,
      "type": "integer"
    },
    "category_uid": {
      "const": 4,
      "type": "integer"
    },
    "activity_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "type_uid": {
      "type": "integer"
    },
    "severity_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "status_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "metadata": {
      "type": "object",
      "description": "OCSF metadata object (subset).",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "log_source": {
          "type": "string"
        }
      }
    },
    "src_endpoint": {
      "type": "object",
      "description": "OCSF network endpoint (subset).",
      "additionalProperties": false,
      "properties": {
        "ip": {
          "type": "string",
          "maxLength": 45
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "hostname": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "query_hostname": {
      "type": "string",
      "maxLength": 253
    },
    "query_type": {
      "type": "string",
      "maxLength": 16
    },
    "rcode_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253
      }
    },
    "tlp": {
      "type": "string",
      "enum": [
        "clear",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "description": "The row's TLP 2.0 label (ADR-0033 decision 5), set by the writer from the source's declaration; the lake refuses a row without one. Not an OCSF attribute. A row stored before the column existed has none and reads as red."
    }
  }
}
