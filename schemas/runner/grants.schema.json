{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/runner/grants/1.0",
  "x-draft": "ADR-0051 (proposed): the agent-runner contract's surface, step 2; not frozen, may change before acceptance",
  "title": "Agent-runner grants file",
  "description": "A compiled profile's MCP servers, rendered by the deploy (hnx gen agent-units, as root) into /etc/hnx-agent/<slug>/grants.json beside the unit template, which pins the file's own sha256 (ADR-0051 decision 3). A body starts only servers whose ids are both in the session spec and here. profile_digest is the compiled profile's digest, a staleness check only.",
  "type": "object",
  "properties": {
    "grants_version": {
      "const": "1.0"
    },
    "profile": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "profile_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "servers": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "transport": {
            "enum": [
              "stdio",
              "http"
            ]
          },
          "locality": {
            "enum": [
              "local",
              "non-local"
            ]
          },
          "command": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^/[^\\u0000-\\u001f]+$(?!\\n)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512
            },
            "maxItems": 64
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 512
            },
            "propertyNames": {
              "pattern": "^[A-Z][A-Z0-9_]*$(?!\\n)"
            }
          },
          "url": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^https?://[a-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._/-]*)?$(?!\\n)"
          }
        },
        "required": [
          "kind",
          "transport",
          "locality"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "stdio"
                }
              }
            },
            "then": {
              "required": [
                "command"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "http"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "command"
                    ]
                  },
                  {
                    "required": [
                      "args"
                    ]
                  },
                  {
                    "required": [
                      "env"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "maxProperties": 64
    }
  },
  "required": [
    "grants_version",
    "profile",
    "profile_digest",
    "servers"
  ],
  "additionalProperties": false
}
