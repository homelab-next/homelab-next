{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/registers/lesson/2.0",
  "title": "Lesson (post-incident learning)",
  "description": "Separates contributing factors (conditions that enabled the problem) from the root cause (why those conditions existed). A lesson needs a preventive control and a falsifiable verification; graded statuses need control_installed_at. 2.0 (ADR-0019): a lesson is identified by its `uid` (a UUIDv7 created with it) and names its `type`; the numbered `id` (and the LL-NEW placeholder a hook used to allocate) is gone, and the number it is shown with is computed from its place among its siblings (`order`, then creation).",
  "type": "object",
  "properties": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?!\\n)",
      "description": "A canonical UUIDv7: the record's identity, never changed."
    },
    "type": {
      "const": "lesson"
    },
    "order": {
      "type": "number",
      "description": "Optional sort key among its siblings."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "date": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/date"
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recurrences": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "controlled",
        "partial",
        "open",
        "retired",
        "grandfathered"
      ]
    },
    "symptom": {
      "type": "string",
      "minLength": 10,
      "description": "What an observer sees; the lookup key."
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "root_cause": {
      "type": "string",
      "minLength": 10,
      "description": "Why the contributing conditions existed. A person or a single command is not a root cause."
    },
    "corrective_action": {
      "type": "string",
      "minLength": 3
    },
    "preventive_control": {
      "type": "string",
      "minLength": 10,
      "description": "Must change what is possible or what is detectable."
    },
    "verification": {
      "type": "string",
      "minLength": 10,
      "description": "A falsifiable test of the control."
    },
    "control_installed_at": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|unknown)$"
    },
    "retired_by": {
      "type": "string",
      "minLength": 3
    }
  },
  "required": [
    "uid",
    "type",
    "title",
    "date",
    "systems",
    "recurrences",
    "status",
    "symptom",
    "contributing_factors",
    "root_cause",
    "corrective_action",
    "preventive_control",
    "verification"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "controlled",
              "partial"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "control_installed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "retired_by"
        ]
      }
    }
  ]
}
