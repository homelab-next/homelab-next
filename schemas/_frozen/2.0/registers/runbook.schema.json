{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/registers/runbook/2.0",
  "title": "Runbook",
  "description": "An ordered checklist in which every step carries its own verify. Answers 'what is the correct way to do this' before starting. 2.0 (ADR-0019): a runbook is identified by its `uid` (a UUIDv7 created with it) and names its `type`; the numbered `id` (and the LL-NEW placeholder a hook used to allocate) is gone, and the number it is shown with is computed from its place among its siblings (`order`, then creation).",
  "type": "object",
  "properties": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?!\\n)",
      "description": "A canonical UUIDv7: the record's identity, never changed."
    },
    "type": {
      "const": "runbook"
    },
    "order": {
      "type": "number",
      "description": "Optional sort key among its siblings."
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "when": {
      "type": "string",
      "minLength": 3,
      "description": "Trigger: when to open this runbook."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 3
          },
          "verify": {
            "type": "string",
            "minLength": 3
          },
          "rollback": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "n",
          "text",
          "verify"
        ]
      },
      "minItems": 1
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^LL-\\d{3,}$"
      }
    }
  },
  "required": [
    "uid",
    "type",
    "title",
    "systems",
    "steps"
  ]
}
