{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/agent/profile/1.5",
  "title": "Compiled agent profile",
  "description": "Output of the profile compiler: harvested parts by logical id, the grants the profile holds, the permission ceiling they were checked against, hard budgets, a deterministic digest and provenance for every part. grants must be a subset of ceiling (mcp, capabilities, tier rank and budgets); JSON Schema cannot express that, so homelabnext.agent.check_ceiling enforces it and the compiler refuses a violation. Model is a role alias, never a model id. 1.1 adds reads_untrusted (additive, optional): true when the profile reads raw or untrusted content; such a reader may hold no shell/exec, file-write, egress or credential grant (homelabnext.agent.readers, data: homelabnext/agent/tool_classes.yml). The compiler always writes it; a profile without it is treated as a reader (fail closed). 1.2 adds include (additive, optional): rules naming which related knowledge from the repository graph goes into the context pack's volatile tier; rules seed only from grants the profile holds and never add one (homelabnext.agent.include, homelabnext.agent.knowledge). The compiler writes it only when the spec has rules, with every default filled in. 1.3 adds, additively, the review tier `audit` to include.require_reviews; `challenge` is its deprecated spelling, accepted and normalised to `audit` by the compiler. 1.4 adds, additively, include.detail (`summary` or `outline`; ADR-0032): the level of each included node the context pack carries instead of its whole content. Absent means `full`, and the compiler never writes `full`, so a profile that does not use it keeps its digest. 1.5 adds, additively, tlp_ceiling (ADR-0033 decision 12): the TLP ceiling the ceiling policy attests for the profile, the most restrictive label it may receive and the least it sends a model at. It agrees with data_tier (local-only is above clear, cloud-allowed is clear). The compiler writes it when the spec or the policy states one; absent, the ceiling is read from data_tier (homelabnext.agent.readers.receive_ceiling, homelabnext.registry.model_tlp.send_ceiling).",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "persona": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/persona_id"
    },
    "model_role": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/mdl_id"
    },
    "parts": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/skill_id"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "skills",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "grants": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
          },
          "uniqueItems": true
        },
        "tier": {
          "enum": [
            "read",
            "write",
            "execute",
            "privileged"
          ]
        }
      },
      "required": [
        "mcp",
        "capabilities",
        "tier"
      ],
      "additionalProperties": false
    },
    "ceiling": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
          },
          "uniqueItems": true
        },
        "tier": {
          "enum": [
            "read",
            "write",
            "execute",
            "privileged"
          ]
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_runtime_s": {
              "type": "integer",
              "minimum": 1
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "max_input_tokens",
            "max_output_tokens",
            "max_runtime_s",
            "max_tool_calls"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mcp",
        "capabilities",
        "tier"
      ],
      "additionalProperties": false
    },
    "memory_scopes": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "uniqueItems": true
    },
    "data_tier": {
      "enum": [
        "local-only",
        "cloud-allowed"
      ]
    },
    "tlp_ceiling": {
      "enum": [
        "clear",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "description": "The profile's TLP ceiling, attested by the ceiling policy (ADR-0033 decision 12): it is granted MCP servers whose tlp is at or below it, and a model request it sends to a role that leaves the lab is judged at least at it. Agrees with data_tier: local-only is a ceiling above clear, cloud-allowed is clear."
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_runtime_s",
        "max_tool_calls"
      ],
      "additionalProperties": false
    },
    "budget_mode": {
      "enum": [
        "warn",
        "enforce"
      ]
    },
    "reads_untrusted": {
      "type": "boolean",
      "description": "The profile reads raw or untrusted content (feeds, alerts, mail, web pages). Absent means true."
    },
    "include": {
      "type": "array",
      "description": "Knowledge include rules, normalised: sorted, de-duplicated, defaults written.",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "enum": [
              "capabilities",
              "mcp",
              "services",
              "task"
            ]
          },
          "only": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "adr",
                "check",
                "doc",
                "inv",
                "lesson",
                "runbook",
                "schema"
              ]
            }
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "max_chars": {
            "type": "integer",
            "minimum": 200,
            "maximum": 20000
          },
          "require_reviews": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "agent_check",
                "audit",
                "challenge",
                "human"
              ]
            }
          },
          "detail": {
            "enum": [
              "summary",
              "outline"
            ],
            "description": "How much of each included node the pack carries: its level-0 summary, or the summary and the heading outline. Absent means the whole content."
          }
        },
        "required": [
          "from",
          "kinds",
          "depth",
          "budget",
          "max_chars"
        ],
        "additionalProperties": false
      }
    },
    "digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0"
          },
          "source": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "digest": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
          }
        },
        "required": [
          "id",
          "source",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "persona",
    "model_role",
    "parts",
    "grants",
    "ceiling",
    "memory_scopes",
    "data_tier",
    "budgets",
    "budget_mode",
    "digest",
    "provenance"
  ],
  "additionalProperties": false
}
