{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/events/deploy.changed/1.1",
  "title": "Event homelabnext.deploy.changed",
  "description": "A component was released or deployed: what changed, from which version to which. Emitted once per deploy by the release/deploy path (homelabnext.events.deploy); the changes list comes from the component's changelog section for the new version, so the event and the changelog never disagree.",
  "allOf": [
    {
      "$ref": "https://schemas.example.internal/homelabnext/events/envelope/1.1"
    },
    {
      "properties": {
        "type": {
          "const": "homelabnext.deploy.changed"
        },
        "data": {
          "type": "object",
          "properties": {
            "deploy_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Identity of this deploy (stable across retries; the event id derives from it)."
            },
            "component": {
              "anyOf": [
                {
                  "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/svc_id"
                },
                {
                  "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
                },
                {
                  "type": "string",
                  "pattern": "^pkg:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              ],
              "description": "What was deployed: a service, a capability or a package (pkg:<name>)."
            },
            "environment": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 32,
              "description": "Where it was deployed (for example lab, staging, pypi)."
            },
            "from_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Version before the deploy; null for a first deploy."
            },
            "to_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "changelog": {
              "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path",
              "description": "The changelog file the changes were read from."
            },
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "added",
                      "changed",
                      "deprecated",
                      "removed",
                      "fixed",
                      "security"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "summary"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "deploy_id",
            "component",
            "to_version",
            "changes"
          ]
        }
      },
      "required": [
        "data"
      ]
    }
  ]
}
