{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/platform/capability/1.1",
  "title": "Capability descriptor",
  "description": "Describes one capability (cap:<name>): the seam, its contract schemas, the conformance suite that proves an implementation, and implementations known. 1.1 adds the slot registry's fields (ADR-0027, proposed; docs/modules.md, 'The slot registry'): the contract protocol, the SOC pipeline stage, boundary formats, statefulness and export formats, whether a site must select a provider, whether the slot is a trust root, and whether its stage may be passed through. Under modules, implementations is derived from provider manifests, never listed.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 13
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://schemas\\.example\\.internal/homelabnext/"
      }
    },
    "conformance": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path"
    },
    "status": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "boolean"
        },
        "fake": {
          "type": "boolean"
        },
        "conformance": {
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "fake",
        "conformance"
      ]
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "adapter": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "kind": {
            "enum": [
              "fake",
              "reference",
              "product"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "experimental",
              "supported"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "status"
        ]
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
      },
      "uniqueItems": true
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "stage": {
      "$ref": "#/$defs/stage"
    },
    "formats": {
      "$ref": "#/$defs/formats"
    },
    "export_formats": {
      "$ref": "#/$defs/export_formats"
    },
    "stateful": {
      "$ref": "#/$defs/flag"
    },
    "required_in_core": {
      "$ref": "#/$defs/flag"
    },
    "privileged": {
      "$ref": "#/$defs/flag"
    },
    "pass_through": {
      "$ref": "#/$defs/flag"
    }
  },
  "required": [
    "id",
    "title",
    "layer",
    "summary",
    "contracts",
    "status"
  ],
  "$defs": {
    "contract": {
      "description": "the protocol file in conformance/protocols/, or null: a slot with no contract yet is provisional by declaration",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]*\\.py$"
    },
    "stage": {
      "description": "the SOC pipeline stage (1-10), or null for a core slot outside the pipeline; layer stays",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 10
    },
    "formats": {
      "description": "the boundary formats in and out: pass-through is legal only where the upstream's out meets the downstream's in",
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "uniqueItems": true
        },
        "out": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false
    },
    "export_formats": {
      "description": "the neutral formats a stateful slot's providers export and migrate in",
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "flag": {
      "type": "boolean"
    },
    "slot_rules": {
      "description": "the slot registry's rules, each one triggered only by a field 1.1 introduced",
      "allOf": [
        {
          "if": {
            "required": [
              "stateful"
            ],
            "properties": {
              "stateful": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "export_formats"
            ]
          }
        },
        {
          "if": {
            "required": [
              "export_formats"
            ]
          },
          "then": {
            "required": [
              "stateful"
            ],
            "properties": {
              "stateful": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "privileged"
            ],
            "properties": {
              "privileged": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "contract"
            ],
            "properties": {
              "contract": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "pass_through"
            ],
            "properties": {
              "pass_through": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "stage",
              "formats"
            ],
            "properties": {
              "stage": {
                "type": "integer"
              },
              "required_in_core": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "slot": {
      "description": "a slot registry entry: the 1.1 fields alone, as the draft registry (examples/modules/slots.yml) carries them",
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "formats": {
          "$ref": "#/$defs/formats"
        },
        "stateful": {
          "$ref": "#/$defs/flag"
        },
        "export_formats": {
          "$ref": "#/$defs/export_formats"
        },
        "required_in_core": {
          "$ref": "#/$defs/flag"
        },
        "privileged": {
          "$ref": "#/$defs/flag"
        },
        "pass_through": {
          "$ref": "#/$defs/flag"
        }
      },
      "required": [
        "stage",
        "contract",
        "stateful"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/slot_rules"
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/slot_rules"
    },
    {
      "description": "contracts may be empty only for a slot declared without a contract",
      "if": {
        "required": [
          "contract"
        ],
        "properties": {
          "contract": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "contracts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "description": "a trust root is never provisional: it has a conformance suite",
      "if": {
        "required": [
          "privileged"
        ],
        "properties": {
          "privileged": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "conformance"
        ]
      }
    }
  ]
}
