{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/registers/invariant/1.0",
  "title": "Invariant criterion",
  "description": "A property that must be continuously true, decided by a command. Auto checks: exit 0 pass, non-zero fail, >=100 could not measure. Any criterion that is red needs a remediation (enforced by the generator, not here).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]-(\\d{2}|NEW)$"
    },
    "pillar": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "observable": {
      "type": "string",
      "minLength": 3
    },
    "expected": {
      "type": "string",
      "minLength": 3
    },
    "evidence": {
      "enum": [
        "auto",
        "manual"
      ]
    },
    "check": {
      "type": "string",
      "minLength": 1
    },
    "remediation": {
      "type": "string",
      "minLength": 10
    },
    "slow": {
      "type": "boolean"
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "status": {
      "enum": [
        "untested",
        "pass",
        "fail",
        "deferred"
      ]
    },
    "last_checked": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/date"
    },
    "evidence_note": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "pillar",
    "statement",
    "observable",
    "expected",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "const": "auto"
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "required": [
          "check"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "const": "manual"
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "last_checked"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deferred"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    }
  ]
}
