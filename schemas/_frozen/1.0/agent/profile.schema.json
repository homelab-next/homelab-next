{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/agent/profile/1.0",
  "title": "Compiled agent profile",
  "description": "Output of the profile compiler: harvested parts by logical id, the grants the profile holds, the permission ceiling they were checked against, hard budgets, a deterministic digest and provenance for every part. grants must be a subset of ceiling (mcp, capabilities, tier rank and budgets); JSON Schema cannot express that, so homelabnext.agent.check_ceiling enforces it and the compiler refuses a violation. Model is a role alias, never a model id.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "persona": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/persona_id"
    },
    "model_role": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/mdl_id"
    },
    "parts": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/skill_id"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "skills",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "grants": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
          },
          "uniqueItems": true
        },
        "tier": {
          "enum": [
            "read",
            "write",
            "execute",
            "privileged"
          ]
        }
      },
      "required": [
        "mcp",
        "capabilities",
        "tier"
      ],
      "additionalProperties": false
    },
    "ceiling": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/cap_id"
          },
          "uniqueItems": true
        },
        "tier": {
          "enum": [
            "read",
            "write",
            "execute",
            "privileged"
          ]
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_runtime_s": {
              "type": "integer",
              "minimum": 1
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "max_input_tokens",
            "max_output_tokens",
            "max_runtime_s",
            "max_tool_calls"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mcp",
        "capabilities",
        "tier"
      ],
      "additionalProperties": false
    },
    "memory_scopes": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
      },
      "uniqueItems": true
    },
    "data_tier": {
      "enum": [
        "local-only",
        "cloud-allowed"
      ]
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_runtime_s",
        "max_tool_calls"
      ],
      "additionalProperties": false
    },
    "budget_mode": {
      "enum": [
        "warn",
        "enforce"
      ]
    },
    "digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0"
          },
          "source": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "digest": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
          }
        },
        "required": [
          "id",
          "source",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "persona",
    "model_role",
    "parts",
    "grants",
    "ceiling",
    "memory_scopes",
    "data_tier",
    "budgets",
    "budget_mode",
    "digest",
    "provenance"
  ],
  "additionalProperties": false
}
