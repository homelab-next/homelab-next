{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/platform/service/1.0",
  "title": "HomelabNext service registry (services.yml)",
  "description": "Single source of truth for what runs where. Every endpoint, scrape target, proxy site, firewall rule, DNS record and environment file is generated from this document. Schema version 1; evolve additively.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "lab", "zones", "hosts", "services"],
  "properties": {
    "registry_version": {"const": 1},
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "domain": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", "description": "Base DNS domain, e.g. example.internal"},
        "svc_label": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,15}$", "default": "svc", "description": "Alias zone is <svc_label>.<domain>"},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "zones": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr"],
        "properties": {
          "cidr": {"type": "string", "pattern": "^[0-9a-f:.]+/[0-9]{1,3}$"},
          "description": {"type": "string"}
        }
      }
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "zone"],
        "properties": {
          "address": {"type": "string", "pattern": "^[0-9a-f:.]+$"},
          "zone": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
          "role": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
      "additionalProperties": {"$ref": "#/$defs/service"}
    }
  },
  "$defs": {
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "host", "protocol", "port", "owner", "version", "tls"],
      "properties": {
        "capability": {"$ref": "#/$defs/capability", "description": "The stable alias consumers resolve: <capability>.<svc_label>.<domain>. Swapping the product behind it never changes consumers."},
        "impl": {"type": "string", "description": "Current product implementing the capability (informational)."},
        "host": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "protocol": {"enum": ["http", "https", "grpc", "tcp", "udp", "postgres", "nats", "dns", "ssh"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["http", "tcp", "none"]},
            "path": {"type": "string", "pattern": "^/"},
            "expect_status": {"type": "integer", "minimum": 100, "maximum": 599},
            "interval_s": {"type": "integer", "minimum": 5, "maximum": 3600}
          },
          "if": {"properties": {"kind": {"const": "http"}}},
          "then": {"required": ["kind", "path"]}
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "upstreams": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"},
          "description": "Capability aliases this service calls. Drives env wiring and the firewall matrix."
        },
        "clients": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
          "description": "Extra zones (beyond dependants) allowed to reach this service."
        },
        "owner": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?$"},
        "tls": {"enum": ["none", "internal", "public", "mtls"]},
        "auth": {"enum": ["none", "idp", "own", "mtls"], "default": "none"},
        "public_hostname": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"},
        "backup_job": {"type": "string"},
        "env_var": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "Override of the default endpoint env var name."},
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$"},
            "transport": {"enum": ["http", "sse", "stdio"], "default": "http"},
            "path": {"type": "string", "pattern": "^/", "default": "/mcp"}
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9:_-]{0,31}$"}
        }
      }
    }
  }
}
