{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/events/decision.returned/1.0",
  "title": "Event homelabnext.decision.returned",
  "description": "The decision service answered. A failure or low confidence returns escalate, never a silent accept.",
  "allOf": [
    {
      "$ref": "https://schemas.example.internal/homelabnext/events/envelope/1.0"
    },
    {
      "properties": {
        "type": {
          "const": "homelabnext.decision.returned"
        },
        "data": {
          "type": "object",
          "properties": {
            "decision_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "verdict": {
              "enum": [
                "accept",
                "reject",
                "escalate"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "tier_used": {
              "enum": [
                "floor",
                "small",
                "large",
                "llm",
                "human"
              ]
            },
            "latency_ms": {
              "type": "integer",
              "minimum": 0
            },
            "model_role": {
              "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/mdl_id"
            }
          },
          "required": [
            "decision_id",
            "verdict",
            "confidence",
            "tier_used"
          ]
        }
      },
      "required": [
        "data"
      ]
    }
  ]
}
