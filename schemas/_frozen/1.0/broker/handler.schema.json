{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/broker/handler/1.0",
  "title": "Broker handler",
  "description": "Declares one handler implementation: which action it serves, its tier, where it lives and the digest of its content. A handler that mutates (execute, privileged) must require approval; every handler is audited.",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "handler": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path"
    },
    "handler_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "tier": {
      "enum": [
        "read",
        "write",
        "execute",
        "privileged"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "params_schema": {
      "type": "object"
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "idempotent": {
      "type": "boolean"
    },
    "requires_approval": {
      "type": "boolean"
    },
    "audit": {
      "const": true
    }
  },
  "required": [
    "action",
    "handler",
    "handler_digest",
    "tier",
    "description",
    "params_schema",
    "timeout_s",
    "idempotent",
    "requires_approval",
    "audit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "enum": [
              "execute",
              "privileged"
            ]
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        }
      }
    }
  ]
}
