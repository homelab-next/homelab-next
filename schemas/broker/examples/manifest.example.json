{
  "actions": [
    {
      "action": "service.status",
      "handler": "handlers/service-status.sh",
      "requires_approval": false,
      "tier": "read"
    },
    {
      "action": "dns.lookup",
      "handler": "handlers/dns-lookup.sh",
      "requires_approval": false,
      "tier": "read"
    },
    {
      "action": "dhcp.leases",
      "handler": "handlers/dhcp-leases.sh",
      "requires_approval": false,
      "tier": "read"
    },
    {
      "action": "hypervisor.guests",
      "handler": "handlers/hypervisor-guests.sh",
      "requires_approval": false,
      "tier": "read"
    },
    {
      "action": "records.annotate",
      "handler": "handlers/records-annotate.sh",
      "requires_approval": false,
      "tier": "write"
    },
    {
      "action": "service.restart",
      "handler": "handlers/service-restart.sh",
      "requires_approval": true,
      "tier": "execute"
    },
    {
      "action": "host.reboot",
      "handler": "handlers/host-reboot.sh",
      "requires_approval": true,
      "tier": "privileged"
    }
  ],
  "approval_ttl_s": 900,
  "approvers": [
    {
      "issuer": "sso",
      "kind": "human",
      "subject": "approver-one"
    }
  ],
  "default": "deny",
  "grants": [
    {
      "actions": [
        "service.status",
        "dns.lookup",
        "dhcp.leases",
        "hypervisor.guests"
      ],
      "max_tier": "read",
      "profile": "profile:reader"
    },
    {
      "actions": [
        "service.status",
        "dns.lookup",
        "dhcp.leases",
        "hypervisor.guests",
        "records.annotate",
        "service.restart"
      ],
      "max_tier": "execute",
      "profile": "profile:operator"
    }
  ],
  "manifest_id": "example-broker",
  "mode": "enforce"
}
