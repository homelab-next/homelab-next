{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/broker/manifest/1.2",
  "title": "Broker manifest",
  "description": "The allowlist. default is the constant deny: an action absent from actions, an actor absent from grants, or a tier above the grant's max_tier is refused. mode shadow records decisions without enforcing them. approvers is the allowlist of identities (issuer and subject, compared normalized) whose approvals count; without it no approval is accepted. An approver of kind agent, or one whose subject names a granted profile, counts only when allow_agent_approvers is true. approval_ttl_s defaults to 900 when absent. 1.1 adds approvers and allow_agent_approvers. 1.2 adds, additively, lanes (write lanes the broker's built-in lane handler writes into: kind files or records-inbox, a root under the data root, per-actor subdirectories, a filename pattern, a size cap, a format and an optional content schema, exclusive create unless overwrite), an action's optional lane (its handler is then builtin/lane) and handler_docs (the handler documents, relative to the manifest, that pin each exec handler's digest).",
  "type": "object",
  "properties": {
    "manifest_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "default": {
      "const": "deny"
    },
    "mode": {
      "enum": [
        "shadow",
        "enforce"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "tier": {
            "enum": [
              "read",
              "write",
              "execute",
              "privileged"
            ]
          },
          "handler": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path"
          },
          "requires_approval": {
            "type": "boolean"
          },
          "lane": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug",
            "description": "The lane this action writes into; its handler is then builtin/lane and its tier write (checked by hnx broker validate)."
          }
        },
        "required": [
          "action",
          "tier",
          "handler",
          "requires_approval"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "tier": {
                  "enum": [
                    "execute",
                    "privileged"
                  ]
                }
              },
              "required": [
                "tier"
              ]
            },
            "then": {
              "properties": {
                "requires_approval": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
            },
            "uniqueItems": true
          },
          "max_tier": {
            "enum": [
              "read",
              "write",
              "execute",
              "privileged"
            ]
          }
        },
        "required": [
          "profile",
          "actions",
          "max_tier"
        ],
        "additionalProperties": false
      }
    },
    "approval_ttl_s": {
      "type": "integer",
      "minimum": 1
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "subject": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "kind": {
            "enum": [
              "human",
              "agent"
            ]
          }
        },
        "required": [
          "issuer",
          "subject"
        ],
        "additionalProperties": false
      }
    },
    "allow_agent_approvers": {
      "type": "boolean"
    },
    "handler_docs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path"
      },
      "uniqueItems": true,
      "description": "Handler documents (schemas/broker/handler), relative to the manifest file."
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "kind": {
            "enum": [
              "files",
              "records-inbox"
            ]
          },
          "root": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path",
            "description": "Directory under the broker's data root."
          },
          "per_actor": {
            "type": "boolean",
            "description": "Write into <root>/<actor's profile slug>/ (default true for files; a records-inbox lane is shared)."
          },
          "filename_pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Regular expression the whole file name must match."
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "format": {
            "enum": [
              "text",
              "json"
            ]
          },
          "content_schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9._-]*$",
            "description": "<dir>/<name> of a packaged schema the JSON content must satisfy."
          },
          "overwrite": {
            "type": "boolean",
            "description": "Replace an existing file atomically; default false (exclusive create)."
          },
          "note_types": {
            "type": "array",
            "items": {
              "enum": [
                "proposal",
                "finding",
                "escalation",
                "task"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "kind",
          "root",
          "max_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "manifest_id",
    "default",
    "mode",
    "actions",
    "grants"
  ],
  "additionalProperties": false
}
