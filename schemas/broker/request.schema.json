{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/broker/request/1.0",
  "title": "Broker request",
  "description": "A request for one allowlisted action. digest is the sha256 of the canonical JSON of {action, actor, target, params}; approvals bind to it, so any change after approval is detectable (homelabnext.broker.request_digest).",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "actor": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "target": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/svc_id"
    },
    "params": {
      "type": "object"
    },
    "created": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/timestamp"
    },
    "digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    }
  },
  "required": [
    "request_id",
    "action",
    "actor",
    "params",
    "created",
    "digest"
  ],
  "additionalProperties": false
}
