{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/broker/handler/1.2",
  "title": "Broker handler",
  "description": "Declares one handler implementation: which action it serves, its tier, where it lives and the digest of its content. A handler that mutates (execute, privileged) must require approval; every handler is audited. 1.1 adds, additively, argv (fixed arguments; the request's params arrive as JSON on stdin, never on the command line), secrets (names of secrets the broker resolves at run time and hands to this handler only, as environment variables) and max_output_bytes (stdout and stderr cap each). 1.2 adds, additively, result_schema (a JSON Schema object describing the handler's output once decoded as JSON; the Code Mode generator types the method's result from it, the broker does not check output against it).",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "handler": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/rel_path"
    },
    "handler_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "tier": {
      "enum": [
        "read",
        "write",
        "execute",
        "privileged"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "params_schema": {
      "type": "object"
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "idempotent": {
      "type": "boolean"
    },
    "requires_approval": {
      "type": "boolean"
    },
    "audit": {
      "const": true
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 32
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "result_schema": {
      "type": "object"
    }
  },
  "required": [
    "action",
    "handler",
    "handler_digest",
    "tier",
    "description",
    "params_schema",
    "timeout_s",
    "idempotent",
    "requires_approval",
    "audit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "enum": [
              "execute",
              "privileged"
            ]
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        }
      }
    }
  ]
}
