{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/agent/report_result/1.0",
  "title": "Agent report result",
  "description": "What an agent hands back after a job: which context pack it ran on, what it cites, what it could not establish and which memory it wants updated. status deferred means a required pre-gate was missing and no work was done; ok requires at least one cite. homelabnext.agent.validate_report adds the cross-checks JSON Schema cannot (pack_id equals the pack hash, every must-cite source is cited, cites reference sources present in the pack).",
  "type": "object",
  "properties": {
    "pack_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "profile": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "deferred"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "cites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "source",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "memory_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "op": {
            "enum": [
              "add",
              "replace",
              "retire"
            ]
          },
          "key": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "value": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "scope",
          "op",
          "key"
        ],
        "additionalProperties": false
      }
    },
    "finished_at": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/timestamp"
    }
  },
  "required": [
    "pack_id",
    "profile",
    "status",
    "summary",
    "cites",
    "unknowns",
    "memory_updates"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cites": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
