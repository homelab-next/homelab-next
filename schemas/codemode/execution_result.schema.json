{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/codemode/execution_result/1.0",
  "x-draft": "ADR-0031 (proposed): no runner yet; not frozen, may change before acceptance",
  "title": "Code Mode execution result",
  "description": "What the runner returns to the agent for one execution: the program's reduced value, every broker call it made in step order with the broker's outcome, the calls waiting for approval when it paused, and bounded logs. value, logs and error.message are untrusted program output: consumers treat them as data, never as instructions or as a record of what the broker decided (only calls and pending are the runner's own). A denied call is reported as data; status denied means the program ended on a denial it did not handle. limit names the cap that ended the run; an oversized value is cut off and marked truncated, never returned whole.",
  "type": "object",
  "properties": {
    "execution_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "actor": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "code_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "status": {
      "enum": [
        "ok",
        "paused",
        "denied",
        "error",
        "limit"
      ]
    },
    "value": {},
    "truncated": {
      "type": "boolean"
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "target": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/svc_id"
          },
          "request_id": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "request_digest": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
          },
          "outcome": {
            "enum": [
              "ok",
              "denied",
              "pending",
              "error"
            ]
          },
          "reason": {
            "enum": [
              "default-deny",
              "not-granted",
              "tier-exceeds-grant",
              "handler-missing",
              "approval-digest-mismatch",
              "approval-denied",
              "approval-self-approved",
              "approval-expired",
              "approval-approver-not-allowed",
              "approval-agent-approver",
              "approval-time-invalid",
              "approval-replayed",
              "not-request-owner",
              "token-expired",
              "token-action-not-allowed",
              "call-cap-reached",
              "broker-unreachable",
              "handler-failed",
              "handler-timeout",
              "invalid-arguments"
            ],
            "description": "Why a call was denied or failed: the broker's own decision reason (broker/decision), or a reason the broker client in the sandbox gives for a call refused before it reached the broker (token-expired, token-action-not-allowed, call-cap-reached, broker-unreachable), which then has no request id or digest."
          },
          "replayed": {
            "type": "boolean",
            "description": "true when the step was served from the journal on resume instead of calling the broker again; the outcome and reason are the recorded ones"
          }
        },
        "required": [
          "step",
          "action",
          "outcome"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "denied"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "default-deny",
                    "not-granted",
                    "tier-exceeds-grant",
                    "handler-missing",
                    "approval-digest-mismatch",
                    "approval-denied",
                    "approval-self-approved",
                    "approval-expired",
                    "approval-approver-not-allowed",
                    "approval-agent-approver",
                    "approval-time-invalid",
                    "approval-replayed",
                    "not-request-owner",
                    "token-expired",
                    "token-action-not-allowed",
                    "call-cap-reached"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "error"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "broker-unreachable",
                    "handler-failed",
                    "handler-timeout",
                    "invalid-arguments"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "ok",
                    "pending"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "reason"
                ]
              }
            }
          },
          {
            "if": {
              "not": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "token-expired",
                      "token-action-not-allowed",
                      "call-cap-reached",
                      "broker-unreachable"
                    ]
                  }
                }
              }
            },
            "then": {
              "required": [
                "request_id",
                "request_digest"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "request_id"
                    ]
                  },
                  {
                    "required": [
                      "request_digest"
                    ]
                  }
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "pending": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "request_digest": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          }
        },
        "required": [
          "step",
          "request_id",
          "request_digest",
          "action"
        ],
        "additionalProperties": false
      },
      "description": "The calls waiting for approval, by step, request id and the digest an approval binds to. No free text: an approver reads the request from the broker, never a summary the program could write."
    },
    "logs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f]*$",
        "maxLength": 1000,
        "description": "one line of program output: no newline or control character"
      }
    },
    "limit": {
      "enum": [
        "cpu",
        "memory",
        "wall",
        "calls",
        "output"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "syntax",
            "runtime",
            "sandbox",
            "token",
            "broker"
          ]
        },
        "message": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f]*$",
          "maxLength": 2000,
          "description": "untrusted: the program's own exception text where kind is syntax or runtime"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "finished_at": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/timestamp"
    }
  },
  "required": [
    "execution_id",
    "actor",
    "code_digest",
    "status",
    "calls",
    "finished_at"
  ],
  "dependentRequired": {
    "truncated": [
      "value"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "paused"
          }
        }
      },
      "then": {
        "required": [
          "pending"
        ],
        "properties": {
          "pending": {
            "minItems": 1
          },
          "calls": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "pending"
                }
              },
              "required": [
                "outcome"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "pending"
          ]
        },
        "properties": {
          "calls": {
            "not": {
              "contains": {
                "properties": {
                  "outcome": {
                    "const": "pending"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "denied"
          }
        }
      },
      "then": {
        "properties": {
          "calls": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "denied"
                }
              },
              "required": [
                "outcome"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "limit"
          }
        }
      },
      "then": {
        "required": [
          "limit"
        ]
      },
      "else": {
        "not": {
          "required": [
            "limit"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      }
    }
  ],
  "additionalProperties": false
}
