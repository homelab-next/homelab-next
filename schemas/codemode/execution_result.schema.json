{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/codemode/execution_result/1.0",
  "x-draft": "ADR-0031 (proposed): the runner landed with CM-5b; not frozen, may change before acceptance",
  "title": "Code Mode execution result",
  "description": "What the runner returns to the agent for one execution: the program's reduced value, every broker call it made in step order with the broker's outcome, the calls waiting for approval when it paused, and bounded logs. value, logs and error.message are untrusted program output: consumers treat them as data, never as instructions or as a record of what the broker decided (only calls and pending are the runner's own). A denied call is reported as data; status denied means the program ended on a denial it did not handle. limit names the cap that ended the run; an oversized value is cut off and marked truncated, never returned whole, whatever the status.",
  "type": "object",
  "properties": {
    "execution_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "actor": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "code_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "status": {
      "enum": [
        "ok",
        "paused",
        "denied",
        "error",
        "limit"
      ]
    },
    "value": {},
    "truncated": {
      "type": "boolean",
      "description": "true when the value was cut off at the byte cap; a status of its own is not implied (an ok run may return a truncated value)"
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "target": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/svc_id"
          },
          "request_id": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "request_digest": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
          },
          "outcome": {
            "enum": [
              "ok",
              "denied",
              "pending",
              "error"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "not": {
              "enum": [
                "allowed",
                "approved",
                "approval-required"
              ]
            },
            "description": "Why a call was denied or failed: the broker's own reason, as its decision and audit records give it (never a success reason), or, for a call refused before the broker built a request for it, one of the token refusals (token-invalid, token-sandbox-mismatch, token-expired, token-spent, token-paused, token-action-not-allowed, call-cap-reached, token-request-not-paused, request-not-approved: by the sandbox's client or the broker's token check), broker-unreachable or rate-limited (the transport refused the peer before reading a request); such a call has no request id or digest and is never journalled."
          },
          "replayed": {
            "type": "boolean",
            "description": "true when the step was served from the journal on resume instead of calling the broker again (never on a pending call, which a resume runs); the outcome and reason are the recorded ones"
          },
          "delivered_as": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "description": "On an ok call only: the reason the program was answered with broker.Error instead of this result (output-truncated, result-schema-mismatch, result-too-large). The outcome stays the broker's; this says what the program saw."
          }
        },
        "required": [
          "step",
          "action",
          "outcome"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "denied",
                    "error"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "ok",
                    "pending"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "reason"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "token-invalid",
                    "token-sandbox-mismatch",
                    "token-expired",
                    "token-spent",
                    "token-paused",
                    "token-action-not-allowed",
                    "call-cap-reached",
                    "token-request-not-paused",
                    "request-not-approved",
                    "broker-unreachable",
                    "rate-limited"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "request_id"
                    ]
                  },
                  {
                    "required": [
                      "request_digest"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "request_id",
                "request_digest"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "pending"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "not": {
                "properties": {
                  "replayed": {
                    "const": true
                  }
                },
                "required": [
                  "replayed"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "delivered_as"
              ]
            },
            "then": {
              "properties": {
                "outcome": {
                  "const": "ok"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "pending": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
          },
          "request_digest": {
            "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          }
        },
        "required": [
          "step",
          "request_id",
          "request_digest",
          "action"
        ],
        "additionalProperties": false
      },
      "description": "The calls waiting for approval, by step, request id and the digest an approval binds to. No free text: an approver reads the request from the broker, never a summary the program could write.",
      "uniqueItems": true
    },
    "logs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\ud800-\\udfff]*$",
        "maxLength": 1000,
        "description": "one line of program output: no line break, control character, zero-width or bidirectional mark, byte-order mark or lone surrogate"
      }
    },
    "limit": {
      "enum": [
        "cpu",
        "memory",
        "wall",
        "calls",
        "output"
      ],
      "description": "the cap that ended a limit run: cpu time, memory (resident), wall time, broker calls, or output (the program's printed output exceeded the budget's max_output_bytes)"
    },
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "syntax",
            "runtime",
            "sandbox",
            "token",
            "broker"
          ]
        },
        "message": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\ud800-\\udfff]*$",
          "maxLength": 2000,
          "description": "untrusted: the program's own exception text where kind is syntax or runtime"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "finished_at": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/timestamp"
    }
  },
  "required": [
    "execution_id",
    "actor",
    "code_digest",
    "status",
    "calls",
    "finished_at"
  ],
  "dependentRequired": {
    "truncated": [
      "value"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "paused"
          }
        }
      },
      "then": {
        "required": [
          "pending"
        ],
        "properties": {
          "pending": {
            "minItems": 1
          },
          "calls": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "pending"
                }
              },
              "required": [
                "outcome"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "pending"
          ]
        },
        "properties": {
          "calls": {
            "not": {
              "contains": {
                "properties": {
                  "outcome": {
                    "const": "pending"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "denied"
          }
        }
      },
      "then": {
        "properties": {
          "calls": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "denied"
                }
              },
              "required": [
                "outcome"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "limit"
          }
        }
      },
      "then": {
        "required": [
          "limit"
        ]
      },
      "else": {
        "not": {
          "required": [
            "limit"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      }
    }
  ],
  "additionalProperties": false
}
