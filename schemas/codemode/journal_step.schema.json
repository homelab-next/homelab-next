{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/codemode/journal_step/1.0",
  "x-draft": "ADR-0031 (proposed): no runner yet; not frozen, may change before acceptance",
  "title": "Code Mode step-journal record",
  "description": "One step of an execution, keyed by (execution_id, step) and bound to the actor and the program (code_digest). On resume the runner serves a recorded ok, denied or error step instead of calling the broker again only when the actor, the code digest and the step's request digest all match; a mismatch is a different call and is refused, never replayed. A pending step records the broker request waiting for approval: on resume, once approved, the runner runs that request_id (the approval binds to its digest) instead of submitting a new one. result is the broker's redacted result and result_digest the sha256 of its canonical JSON.",
  "type": "object",
  "properties": {
    "execution_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "actor": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/profile_id"
    },
    "code_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "target": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/logical-id/1.0#/$defs/svc_id"
    },
    "request_id": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/slug"
    },
    "request_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "outcome": {
      "enum": [
        "ok",
        "denied",
        "pending",
        "error"
      ]
    },
    "reason": {
      "enum": [
        "default-deny",
        "not-granted",
        "tier-exceeds-grant",
        "handler-missing",
        "approval-digest-mismatch",
        "approval-denied",
        "approval-self-approved",
        "approval-expired",
        "approval-approver-not-allowed",
        "approval-agent-approver",
        "approval-time-invalid",
        "approval-replayed",
        "not-request-owner",
        "token-expired",
        "token-action-not-allowed",
        "call-cap-reached",
        "broker-unreachable",
        "handler-failed",
        "handler-timeout",
        "invalid-arguments"
      ],
      "description": "Why a call was denied or failed: the broker's own decision reason (broker/decision), or a reason the broker client in the sandbox gives for a call refused before it reached the broker (token-expired, token-action-not-allowed, call-cap-reached, broker-unreachable), which then has no request id or digest."
    },
    "result": {},
    "result_digest": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/sha256"
    },
    "recorded_at": {
      "$ref": "https://schemas.example.internal/homelabnext/ids/common/1.0#/$defs/timestamp"
    }
  },
  "required": [
    "execution_id",
    "actor",
    "code_digest",
    "step",
    "action",
    "outcome",
    "recorded_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "denied"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "default-deny",
              "not-granted",
              "tier-exceeds-grant",
              "handler-missing",
              "approval-digest-mismatch",
              "approval-denied",
              "approval-self-approved",
              "approval-expired",
              "approval-approver-not-allowed",
              "approval-agent-approver",
              "approval-time-invalid",
              "approval-replayed",
              "not-request-owner",
              "token-expired",
              "token-action-not-allowed",
              "call-cap-reached"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "broker-unreachable",
              "handler-failed",
              "handler-timeout",
              "invalid-arguments"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ok",
              "pending"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "token-expired",
                "token-action-not-allowed",
                "call-cap-reached",
                "broker-unreachable"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "request_id",
          "request_digest"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "request_id"
              ]
            },
            {
              "required": [
                "request_digest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ok"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "result",
          "result_digest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pending"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "result"
              ]
            },
            {
              "required": [
                "result_digest"
              ]
            }
          ]
        }
      }
    },
    {
      "dependentRequired": {
        "result": [
          "result_digest"
        ],
        "result_digest": [
          "result"
        ]
      }
    }
  ],
  "additionalProperties": false
}
