{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/homelabnext/lake-writer/ocsf/http_activity/1.0",
  "title": "HTTP Activity",
  "description": "Pinned subset of the OCSF HTTP Activity class (OCSF 1.3.0, class_uid 4002) as the lake-writer module stores it in the soc namespace. Flat top-level columns plus one-level structs; the table, Arrow schema and DDL are generated from this file (homelabnext.lake).",
  "x-lake": {
    "table": "http_activity",
    "ocsf_class": "http_activity",
    "ocsf_class_uid": 4002,
    "ocsf_version": "1.3.0",
    "key": [
      "uid"
    ],
    "time_column": "time",
    "partition": "day(time)"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid",
    "time",
    "class_uid",
    "category_uid",
    "activity_id",
    "severity_id",
    "http_method"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable content-derived event id. This is the idempotency (content) key of the table."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "Event time, RFC 3339 with an explicit offset; stored as UTC."
    },
    "class_uid": {
      "const": 4002,
      "type": "integer"
    },
    "category_uid": {
      "const": 4,
      "type": "integer"
    },
    "activity_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "type_uid": {
      "type": "integer"
    },
    "severity_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "status_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "metadata": {
      "type": "object",
      "description": "OCSF metadata object (subset).",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "log_source": {
          "type": "string"
        }
      }
    },
    "src_endpoint": {
      "type": "object",
      "description": "OCSF network endpoint (subset).",
      "additionalProperties": false,
      "properties": {
        "ip": {
          "type": "string",
          "maxLength": 45
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "hostname": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "dst_endpoint": {
      "type": "object",
      "description": "OCSF network endpoint (subset).",
      "additionalProperties": false,
      "properties": {
        "ip": {
          "type": "string",
          "maxLength": 45
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "hostname": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "http_method": {
      "type": "string",
      "maxLength": 16
    },
    "url": {
      "type": "string",
      "maxLength": 4096
    },
    "http_status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "user_agent": {
      "type": "string",
      "maxLength": 1024
    },
    "bytes_in": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_out": {
      "type": "integer",
      "minimum": 0
    },
    "host_name": {
      "type": "string",
      "maxLength": 253
    },
    "tlp": {
      "type": "string",
      "enum": [
        "clear",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "description": "The row's TLP 2.0 label (ADR-0033 decision 5), set from the event's labels.hnx_tlp by the log pipeline; the lake refuses a row without one. Not an OCSF attribute."
    }
  }
}
