{# SPDX-License-Identifier: Apache-2.0 -#}
# {{ lake_writer_marker }}, instance {{ lake_writer_logical_id }}); local changes are overwritten.
# No secret here: the lake password, the catalog token and the object store key pair are in
# credentials/logins.env (root-only).
HNX_LW_NAMESPACE={{ lake_writer_namespace }}
HNX_LW_TABLES={{ lake_writer_tables | join(',') }}
HNX_LW_STAGING_BUCKET={{ lake_writer_staging_bucket }}
HNX_LW_STAGING_PREFIX={{ lake_writer_staging_prefix }}
HNX_LW_STATE_DIR={{ lake_writer_state_dir }}
HNX_LW_SCHEMA_DIR={{ lake_writer_schema_dir }}
HNX_LW_LAKE_USER={{ lake_writer_lake_user }}
HNX_LW_LAKE_WAREHOUSE={{ lake_writer_lake_warehouse }}
HNX_LW_LAKE_CREDENTIAL={{ lake_writer_login_alias }}
{% if lake_writer_catalog_bearer_ref != '' %}
HNX_LW_CATALOG_CREDENTIAL={{ lake_writer_bearer_alias }}
{% endif %}
{% if lake_writer_lake_ca_ref != '' %}
HNX_LW_LAKE_CA_FILE={{ lake_writer_ca_file }}
{% endif %}
HNX_LW_S3_REGION={{ lake_writer_s3_region }}
HNX_LW_MAX_ATTEMPTS={{ lake_writer_max_attempts | int }}
HNX_LW_MAX_BATCHES={{ lake_writer_max_batches | int }}
HNX_ENDPOINT_LAKE_QUERY={{ lake_writer_effective_lake_query_url }}
HNX_ENDPOINT_LAKE_CATALOG={{ lake_writer_effective_lake_catalog_url }}
HNX_ENDPOINT_OBJECT_STORE={{ lake_writer_effective_object_store_url }}
PYTHONUNBUFFERED=1
PYTHONSAFEPATH=1
PYTHONNOUSERSITE=1
