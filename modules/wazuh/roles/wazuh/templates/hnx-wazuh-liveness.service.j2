# Managed by homelabnext (role wazuh); local changes are overwritten.
[Unit]
Description=homelabnext SIEM manager liveness metrics (role wazuh)
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I {{ wazuh_data_root }}/config/hnx_wazuh_liveness.py --compose-file {{ wazuh_dir }}/docker-compose.yml --alerts-file {{ wazuh_data_root }}/manager/logs/alerts/alerts.json --out {{ wazuh_textfile_dir }}/siem_manager.prom
Nice=10
