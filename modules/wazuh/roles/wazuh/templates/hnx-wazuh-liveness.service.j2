# Managed by homelabnext (role wazuh); local changes are overwritten.
[Unit]
Description=homelabnext SIEM manager liveness metrics (role wazuh)
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/homelabnext/hnx-wazuh-liveness --compose-file {{ wazuh_dir }}/docker-compose.yml --alerts-file {{ wazuh_data_root }}/manager/logs/alerts/alerts.json --out {{ wazuh_textfile_dir }}/siem_manager.prom --group {{ wazuh_textfile_group }}
Nice=10
