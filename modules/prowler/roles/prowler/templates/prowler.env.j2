# {{ prowler_marker }}, instance {{ prowler_logical_id }}); local changes are overwritten.
# The cloud credential of a READ-ONLY principal, root-only (0600): systemd reads it as root and gives the
# scan its values; the scan's user cannot open this file. Never echoed by the exporter.
AWS_ACCESS_KEY_ID={{ prowler_login.split(':', 1)[0] }}
AWS_SECRET_ACCESS_KEY={{ prowler_login.split(':', 1)[1] }}
AWS_DEFAULT_REGION={{ prowler_default_region }}
