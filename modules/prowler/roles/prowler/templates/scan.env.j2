PROWLER_STATE_DIR={{ prowler_state_dir }}
PROWLER_FINDINGS={{ prowler_findings_path }}
PROWLER_FINDINGS_MODE={{ prowler_findings_mode | regex_replace('^0', '') }}
PROWLER_MUTELIST={{ prowler_mutelist_file }}
PROWLER_REGIONS={{ prowler_regions | join(' ') }}
PROWLER_TIMEOUT_S={{ prowler_timeout_s }}
