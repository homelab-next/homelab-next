# {{ prowler_marker }}, instance {{ prowler_logical_id }}); local changes are overwritten.
# One scan: the exporter runs the scanner read-only and replaces the findings file. The cloud credential
# is read from a root-only file by systemd and handed to the process as environment; the scan's user
# can read neither the file nor anything outside its own working directories.
[Unit]
Description=prowler {{ prowler_logical_id }}: read-only cloud-posture scan, findings to a file
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ prowler_user }}
Group={{ prowler_group }}
EnvironmentFile={{ prowler_env_file }}
EnvironmentFile={{ prowler_login_env_file }}
# the timer's runs are reported to the shared last-run record (the writer runs privileged: +)
ExecStartPre=-+/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ prowler_last_run_dir }} --group {{ prowler_last_run_group }} --job timer:prowler/scan --unit %n --calendar "{{ prowler_oncalendar }}" --delay 0
ExecStart=/usr/local/libexec/homelabnext/hnx-prowler-export
Environment=PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1
ExecStopPost=-+/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ prowler_last_run_dir }} --group {{ prowler_last_run_group }} --job timer:prowler/scan --unit %n --calendar "{{ prowler_oncalendar }}" --delay 0
# a cold run across every region can take a while; the exporter has its own limit, this is the backstop
TimeoutStartSec={{ (prowler_timeout_s | int) + 600 }}
# read-only cloud work: keep it off the CPU and IO the guest's other jobs need
Nice=10
IOSchedulingClass=idle
{% if hnx_module_slice | default('') %}
Slice={{ hnx_module_slice }}
{% endif %}
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths={{ prowler_state_dir }} {{ prowler_output_dir }} {{ prowler_findings_path | dirname }}
ReadOnlyPaths={{ prowler_venv }} {{ prowler_config_dir }}
MemoryMax=2G
