# Managed by Ansible (role media_automation). Do not edit.
[Unit]
Description=media-automation helper: {{ h.what }}
After=docker.service
ConditionPathIsDirectory={{ media_automation_library_path }}

[Service]
Type=oneshot
User={{ media_automation_uid | int }}
Group={{ media_automation_gid | int }}
EnvironmentFile={{ media_automation_helpers_dir }}/helper.env
Environment=APP_CONFIG_ROOT={{ media_automation_data_root }}/config
Environment=MEDIA_ROOT={{ media_automation_library_path }}
Environment=QBIT_URL=http://{{ media_automation_bind }}:{{ media_automation_qbittorrent_port | int }}
Environment=SONARR_URL=http://{{ media_automation_bind }}:{{ media_automation_sonarr_port | int }}
Environment=RADARR_URL=http://{{ media_automation_bind }}:{{ media_automation_radarr_port | int }}
Environment=STALLED_TORRENT_STATE={{ media_automation_state_dir }}/stalled-torrents.json
Environment=STALLED_TORRENT_HOURS={{ media_automation_helper_stall_hours | int }}
{% if h.id == 'cleanup-downloads' %}
Environment=COMPLETED_ROOT={{ media_automation_downloads_dir }}/qbittorrent/completed
{% endif %}
ExecStart=/usr/bin/python3 -I {{ media_automation_helpers_dir }}/{{ h.script }}{{ h.args }}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ media_automation_library_path }} {{ media_automation_state_dir }}
ReadOnlyPaths={{ media_automation_data_root }}/config
