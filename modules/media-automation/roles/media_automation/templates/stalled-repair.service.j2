# Managed by Ansible (role media_automation). Do not edit.
[Unit]
Description=media-automation helper: remove and re-search torrents with no progress
After=docker.service
ConditionPathIsDirectory={{ media_automation_library_path }}

[Service]
Type=oneshot
User={{ media_automation_uid | int }}
Group={{ media_automation_gid | int }}
EnvironmentFile={{ media_automation_helpers_dir }}/helper.env
Environment=BLACKLIST_FILE=/usr/local/libexec/homelabnext/hnx-media-excluded-file-names.txt
Environment=APP_CONFIG_ROOT={{ media_automation_data_root }}/config
Environment=MEDIA_ROOT={{ media_automation_library_path }}
Environment=QBIT_URL=http://{{ media_automation_bind }}:{{ media_automation_qbittorrent_port | int }}
Environment=SONARR_URL=http://{{ media_automation_bind }}:{{ media_automation_sonarr_port | int }}
Environment=RADARR_URL=http://{{ media_automation_bind }}:{{ media_automation_radarr_port | int }}
Environment=STALLED_TORRENT_STATE={{ media_automation_state_dir }}/stalled-torrents.json
Environment=STALLED_TORRENT_HOURS={{ media_automation_helper_stall_hours | int }}
ExecStart=/usr/local/libexec/homelabnext/hnx-media-stalled-repair
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
ReadWritePaths={{ media_automation_state_dir }}
ReadOnlyPaths={{ media_automation_data_root }}/config
