# Managed by Ansible (role intelowl). Do not edit.
[uwsgi]
project = intel_owl
base = /opt/deploy/intel_owl

chdir = %(base)
module = %(project).wsgi:application

master = true
processes = {{ intelowl_uwsgi_processes | int }}
enable-threads = true

socket = 0.0.0.0:8001
chown = www-data:www-data
vacuum = true
single-interpreter = true
harakiri = 300

logto = /var/log/intel_owl/uwsgi/intel_owl.log
uid = www-data
gid = www-data

max-requests = 1000
max-worker-lifetime = 3600
reload-on-rss = 2048
worker-reload-mercy = 3600

buffer-size = 32768

need-app = true
