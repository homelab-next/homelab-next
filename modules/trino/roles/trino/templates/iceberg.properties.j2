# Managed by homelabnext (module trino); local changes are overwritten. The catalog `{{ trino_catalog_name }}`:
# tables in the REST catalog, files in the object store; the key pair is read from the container's
# environment (${ENV:...}), never from this file.
connector.name=iceberg
{% if item.read_only | default(false) %}
# a catalog the engine itself holds read-only: every write and every table procedure is refused
iceberg.security=read-only
{% endif %}iceberg.catalog.type=rest
iceberg.rest-catalog.uri={{ trino_catalog_endpoint }}{{ trino_catalog_path }}
iceberg.rest-catalog.warehouse={{ trino_warehouse }}
iceberg.rest-catalog.vended-credentials-enabled=false
fs.s3.enabled=true
s3.endpoint={{ trino_s3_endpoint }}
s3.region={{ trino_region }}
s3.path-style-access=true
s3.aws-access-key=${ENV:TRINO_S3_ACCESS_KEY}
s3.aws-secret-key=${ENV:TRINO_S3_SECRET_KEY}
# The floors under the maintenance procedures: the engine refuses an expire_snapshots or a
# remove_orphan_files with a retention shorter than these, whoever asks. remove_orphan_files would
# otherwise default to 7 days, and the lake's orphan retention is 3.
iceberg.expire-snapshots.min-retention={{ trino_expire_min_retention }}
iceberg.remove-orphan-files.min-retention={{ trino_orphan_min_retention }}
