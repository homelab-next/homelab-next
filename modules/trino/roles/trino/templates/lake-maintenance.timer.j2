# Managed by homelabnext (module trino, role trino); local changes are overwritten.
[Unit]
Description=Lake maintenance, nightly (snapshot expiry and orphan-file removal)

[Timer]
OnCalendar={{ trino_maintenance_schedule }}
Persistent={{ 'true' if trino_maintenance_catch_up | bool else 'false' }}
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
