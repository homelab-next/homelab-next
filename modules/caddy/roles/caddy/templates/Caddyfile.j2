# Managed by Ansible (role caddy) for {{ caddy_logical_id }}. Do not edit.
# The sites are the edge generator's (sites.caddy beside this file, rendered for this deployment's
# hosts only); this file adds what is the role's: the global options, a health site on the
# container's own loopback, and the catch-all that loads the certificate and answers 404 for every
# name no site has.
{% macro redacted_fields() %}			fields {
				request>uri query {
					replace api_key REDACTED
					replace apikey REDACTED
					replace ApiKey REDACTED
					replace Api_Key REDACTED
					replace api-key REDACTED
					replace token REDACTED
					replace Token REDACTED
					replace access_token REDACTED
					replace AccessToken REDACTED
					replace X-Emby-Token REDACTED
					replace X-MediaBrowser-Token REDACTED
					replace x-emby-token REDACTED
					replace x-mediabrowser-token REDACTED
					# the sign-in redirect's one-time values (the access log records every callback)
					replace code REDACTED
					replace state REDACTED
					replace session_state REDACTED
					replace id_token REDACTED
				}
				request>headers>Authorization replace REDACTED
				request>headers>X-Emby-Authorization replace REDACTED
				request>headers>X-Emby-Token replace REDACTED
				request>headers>X-Mediabrowser-Token replace REDACTED
				request>headers>X-MediaBrowser-Token replace REDACTED
				request>headers>Cookie replace REDACTED
				request>headers>Proxy-Authorization replace REDACTED
				resp_headers>Set-Cookie replace REDACTED
				# the sign-in redirect carries the request's URI, escaped, in Location (rd=...%3Ftoken%3D...)
				resp_headers>Location regexp "(?i)(token|api_?key|api-key|access_token|id_token|code|state|session_state)(%3d|=)(?:[^&%]|%[^2]|%2[^6])*" "${1}${2}REDACTED"
			}
{% endmacro %}

{
	admin 127.0.0.1:2019  # no-raw-endpoint: allow the admin API on the container's own loopback (caddy reload, the health hook)
	http_port {{ caddy_container_http_port }}
	https_port {{ caddy_container_https_port }}
	# the certificate comes from the host's ACME client (loaded below): Caddy obtains none, and
	# there is no plain-HTTP listener to redirect from (the edge serves 443 only)
	auto_https disable_certs disable_redirects
	persist_config off
	grace_period 10s
	servers {
		protocols h1 h2
	}
	# media-server clients put credentials in query strings and headers, and Caddy logs the whole
	# request (also in warnings such as an aborted upstream response): redact them in the default
	# logger, which carries every non-access message (reverse_proxy warnings, http.log.error)
	log {
		output stderr
		format filter {
			wrap json
{{ redacted_fields() }}		}
	}
	# the edge's access log: one JSON line per request, to a file the SIEM agent on this host reads
	# (tasks/siem.yml) and the log pipeline turns into http_activity rows. The generated sites name
	# this logger (`log hnx_access`), so the default logger above no longer carries their access
	# lines. Same redaction as the default logger.
	log hnx_access {
		output file {{ caddy_container_log_dir }}/{{ caddy_access_log_name }} {
			mode 0640
			roll_size {{ caddy_access_log_roll_size }}
			roll_keep {{ caddy_access_log_roll_keep }}
			roll_keep_for {{ caddy_access_log_roll_keep_for }}
		}
		format filter {
			wrap json
{{ redacted_fields() }}		}
		include http.log.access.hnx_access
	}
}

http://127.0.0.1:{{ caddy_container_health_port }} {  # no-raw-endpoint: allow the healthcheck's site, on the container's own loopback
	bind 127.0.0.1  # no-raw-endpoint: allow bound to the container's own loopback only
	respond "ok" 200
}

https:// {
	tls {{ caddy_container_certs_dir }}/edge.crt {{ caddy_container_certs_dir }}/edge.key
	log hnx_access
	respond "no such site" 404
}

import sites.caddy
