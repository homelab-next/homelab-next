#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# hnx-script:
#   id: caddy-acme-renew
#   kind: job
#   purpose: Renew the edge's public certificate over ACME (DNS-01) when due, install it where Caddy reads it and reload a running Caddy.
#   owner: platform
#   trigger: [timer:caddy/acme-renew, role:caddy]
#   inputs: the DNS provider's token (the root-only environment file, read by the script itself); lego's stored certificate
#   outputs: the edge certificate and key in the module's certs directory; a reload (caddy reload --force) of a running Caddy
#   installs_to: /usr/local/libexec/homelabnext/caddy-acme-renew
#   exit:
#     "0": the installed certificate is valid (renewed and installed, or not yet due); with --check, it is valid
#     "1": with --check, the installed certificate is missing, invalid or due
#     "2": lego failed, or what it stored is not a valid certificate for the names; nothing was installed
#     "3": the certificate was installed but Caddy could not be reloaded (retried next run)
#     "100": could not measure (openssl cannot be run); nothing was checked or installed
"""Managed by Ansible (role caddy); local changes are overwritten.

Without arguments (the renewal unit): run lego, which renews only when fewer than the configured
days remain (or the names changed: ``--force-cert-domains``, so a removed name is dropped rather
than kept from the stored certificate); check what it stored (exactly the configured names, each
verified against the trust bundle, the key matching the certificate, not expired); when that
differs from what Caddy reads, install the key and the certificate (atomically, owned by the
container's user, the key 0600) and reload a running Caddy (``caddy reload --force`` through its
admin API inside the container: a reload, never a restart). ``--check``: is the INSTALLED
certificate valid and not yet due? The role asks this before it starts the unit, so a converged
host is left alone.

The token is read from the root-only environment file by this script and reaches lego in its
environment only (never an argument, never the unit's environment); nothing here prints it."""

import json
import os
import re
import subprocess
import sys
import tempfile

CONF = json.loads({{ {
    'lego': caddy_install_dir ~ '/lego/' ~ caddy_lego_version ~ '/lego',
    'path': caddy_acme_dir,
    'server': caddy_acme_server,
    'email': caddy_acme_email,
    'provider': caddy_acme_dns_provider,
    'token_env': caddy_acme_token_env[caddy_acme_dns_provider],
    'env_file': caddy_acme_env_file,
    'wait': caddy_acme_propagation_wait,
    'renew_days': caddy_acme_renew_days | int,
    'key_type': caddy_acme_key_type,
    'domains': caddy_acme_domains,
    'bundle': caddy_acme_trust_bundle,
    'cert': caddy_cert_file,
    'key': caddy_key_file,
    'uid': caddy_uid | int,
    'gid': caddy_gid | int,
    'compose': caddy_dir ~ '/docker-compose.yml',
    'config': caddy_container_config_dir ~ '/Caddyfile',
} | to_json | to_json }})
NAME = {{ caddy_acme_cert_name | to_json }}  # lego's --cert.name: <path>/certificates/<NAME>.{crt,key}
STORED_CERT = os.path.join(CONF["path"], "certificates", NAME + ".crt")
STORED_KEY = os.path.join(CONF["path"], "certificates", NAME + ".key")
# A reload that failed after an install: the next run (and --check) retries it until it succeeds,
# so a listener still serving the old certificate is never mistaken for a current one.
RELOAD_OWED = os.path.join(CONF["path"], "reload-owed")
PASS_ENV = ("PATH", "HTTPS_PROXY", "https_proxy", "NO_PROXY", "no_proxy", "SSL_CERT_FILE")


class CannotMeasure(Exception):
    """The certificate cannot be checked at all (no openssl): not the same as an invalid one."""


def openssl(*args, data=None):
    try:
        return subprocess.run(["openssl", *args], input=data, capture_output=True, check=False)
    except OSError as e:
        raise CannotMeasure(f"cannot run openssl ({e.strerror}); the host needs it") from None


def problem(cert_path, key_path, due_days, key_pem=None):
    """Why the certificate at ``cert_path`` (leaf first, then its chain) is not usable, or None.
    ``key_pem``: the key's bytes when the caller holds them already (an installed key this process
    cannot open by path: ``held_key``); without it the key is read from ``key_path``."""
    try:
        with open(cert_path, "rb") as f:
            pem = f.read()
    except OSError as e:
        return f"cannot read {cert_path}: {e.strerror}"
    end = b"-----END CERTIFICATE-----"
    if end not in pem:
        return f"{cert_path} holds no certificate"
    leaf = pem[: pem.index(end) + len(end)] + b"\n"
    # exactly the configured names: lego runs with --force-cert-domains, so a name removed from
    # the configuration leaves the certificate, and one still on it is not current
    san = openssl("x509", "-noout", "-ext", "subjectAltName", data=leaf).stdout.decode()
    names = {n.lower() for n in re.findall(r"DNS:([^,\s]+)", san)}
    if names != {n.lower() for n in CONF["domains"]}:
        return f"{cert_path} names {', '.join(sorted(names)) or 'nothing'}, not exactly {', '.join(CONF['domains'])}"
    with tempfile.NamedTemporaryFile(prefix="leaf-", suffix=".pem") as t:
        t.write(leaf)
        t.flush()
        for name in CONF["domains"]:
            r = openssl("verify", "-CAfile", CONF["bundle"], "-untrusted", cert_path,
                        "-verify_hostname", name, "-purpose", "sslserver", t.name)  # fmt: skip
            if r.returncode != 0:
                return f"{cert_path} does not verify for {name} against {CONF['bundle']}"
    r = openssl("x509", "-noout", "-checkend", str(due_days * 86400), data=leaf)
    if r.returncode != 0:
        return f"{cert_path} expires within {due_days} days"
    want = openssl("x509", "-noout", "-pubkey", data=leaf).stdout
    got = (openssl("pkey", "-pubout", data=key_pem) if key_pem is not None
           else openssl("pkey", "-pubout", "-in", key_path))  # fmt: skip
    if got.returncode != 0 or not want or got.stdout != want:
        return f"{key_path} is not the key of {cert_path}"
    return None


def stage(data, dest, mode, held=None):
    """A temporary file beside ``dest`` holding ``data``, owned by the container's user (which
    reads it through a read-only mount), written and synced: renamed over ``dest`` by
    ``install_pair``. With ``held`` (a list)
    the descriptor stays open and is appended to it: the caller reads the file back through it once it
    is owned by an account this process cannot read as (the unit keeps CAP_CHOWN only)."""
    uid, gid = CONF["uid"], CONF["gid"]
    fd, tmp = tempfile.mkstemp(prefix=".acme-", dir=os.path.dirname(dest))
    try:
        os.fchmod(fd, mode)  # the mode first: fchown needs only CAP_CHOWN, whoever the owner is
        os.fchown(fd, uid, gid)
        os.write(fd, data)
        os.fsync(fd)
    except BaseException:
        os.close(fd)
        os.unlink(tmp)
        raise
    if held is None:
        os.close(fd)
    else:
        held.append(fd)
    return tmp


def contents(path):
    with open(path, "rb") as f:
        return f.read()


#: an installed file that exists but cannot be read here (the key, in the unit: see ``held_key``)
UNREADABLE = object()


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None
    except OSError:
        return UNREADABLE


def held_key(fd, path):
    """The key as the staged file holds it, read through the descriptor ``stage`` kept open, or None
    when ``path`` is no longer that file. The unit has CAP_CHOWN and no CAP_DAC_READ_SEARCH: once
    the key is owned by its reader it cannot be opened by path, but a descriptor opened before the
    chown keeps working, and it names the very inode that was renamed into place (stat of the path
    needs no read access), so this checks the installed key, not a copy of it."""
    held, now = os.fstat(fd), os.stat(path)
    if (held.st_dev, held.st_ino) != (now.st_dev, now.st_ino):
        return None
    return os.pread(fd, held.st_size, 0)


def discard(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def install_pair():
    """Replace the key and the certificate as a pair: both are staged and synced first, renamed
    back to back, and checked; a pair that does not check out is put back as it was, and on a
    first install (no earlier pair) removed, so no half-installed pair is ever left behind. No
    staged temporary file outlives the call, and no OSError escapes it. Returns (why the new pair
    was refused, with what was done about it, or None; whether the files are as they were)."""
    old = {CONF["key"]: read(CONF["key"]), CONF["cert"]: read(CONF["cert"])}
    staged, replaced, held, aside = {}, [], [], {}
    try:
        staged[CONF["key"]] = stage(contents(STORED_KEY), CONF["key"], 0o600, held)
        staged[CONF["cert"]] = stage(contents(STORED_CERT), CONF["cert"], 0o644)
        for dest, tmp in staged.items():
            if old[dest] is UNREADABLE:
                # the earlier file cannot be read here to be written back: set it aside by rename
                # (directory access only) and put the same inode back on a rollback
                prev = os.path.join(os.path.dirname(dest), ".acme-prev-" + os.path.basename(dest))
                os.rename(dest, prev)
                aside[dest] = prev
            os.replace(tmp, dest)
            replaced.append(dest)
        key_pem = held_key(held[0], CONF["key"])
        why = (problem(CONF["cert"], CONF["key"], 0, key_pem) if key_pem is not None
               else f"{CONF['key']} is not the key that was staged")
    except OSError as e:
        why = f"install failed: {e.strerror}"
    except CannotMeasure as e:  # installed but not checkable: never left in place unchecked
        why = str(e)
    for tmp in staged.values():
        discard(tmp)
    for fd in held:
        os.close(fd)
    if not why:
        for prev in aside.values():
            discard(prev)
        return None, True
    try:
        for dest, prev in aside.items():
            os.replace(prev, dest)  # the unreadable earlier file, as it was
        for dest in replaced:
            if dest in aside:
                continue
            if old[dest] is None:
                discard(dest)
                continue
            tmp = stage(old[dest], dest, 0o600 if dest == CONF["key"] else 0o644)
            try:
                os.replace(tmp, dest)
            except OSError:
                discard(tmp)
                raise
    except OSError as e:
        why += (f"; putting the old pair back failed too ({e.strerror}): {CONF['cert']} and"
                f" {CONF['key']} may not match, the next run installs the stored pair again")  # fmt: skip
        return why, False
    if not replaced and not aside:
        return f"{why}; the installed pair is unchanged", True
    if all(old[dest] is None for dest in replaced):
        return f"{why}; nothing is installed", True
    return f"{why}; the old pair is back", True


def load_token():
    """The DNS provider's token from the root-only environment file (never this process's
    environment, so the unit's other commands never see it)."""
    try:
        with open(CONF["env_file"], encoding="utf-8") as f:
            for line in f:
                k, _, v = line.rstrip("\n").partition("=")
                if k == CONF["token_env"] and v:
                    return v
    except OSError:
        pass
    return ""


def same(a, b):
    try:
        with open(a, "rb") as x, open(b, "rb") as y:
            return x.read() == y.read()
    except OSError:
        return False


def key_current():
    """Is the installed key the stored one? The unit cannot open an installed key (owned by its
    reader, no CAP_DAC_READ_SEARCH), so an unreadable one counts as current when the certificate
    beside it is: ``install_pair`` renames the key first, so a current certificate means the key
    went in with it (a crash between the two renames leaves the old certificate, which differs)."""
    want = contents(STORED_KEY)
    try:
        with open(CONF["key"], "rb") as f:
            return f.read() == want
    except PermissionError:
        return True
    except OSError:
        return False


def renew():
    openssl("version")  # no openssl: CannotMeasure before lego orders what could not be checked
    env = {k: os.environ[k] for k in PASS_ENV if k in os.environ}
    token = load_token()
    if not token:
        print(f"caddy-acme: no {CONF['token_env']} in {CONF['env_file']}")
        return 2
    env[CONF["token_env"]] = token
    argv = [CONF["lego"], "--log.format", "text", "run", "--accept-tos",
            "--server", CONF["server"], "--path", CONF["path"], "--cert.name", NAME,
            "--key-type", CONF["key_type"], "--dns", CONF["provider"],
            "--dns.propagation.wait", CONF["wait"], "--renew-days", str(CONF["renew_days"]),
            "--no-random-sleep", "--force-cert-domains"]  # fmt: skip
    if CONF["email"]:
        argv += ["--email", CONF["email"]]
    for name in CONF["domains"]:
        argv += ["--domains", name]
    r = subprocess.run(argv, env=env, check=False)
    if r.returncode != 0:
        print(f"caddy-acme: lego failed (exit {r.returncode}); nothing installed")
        return 2
    why = problem(STORED_CERT, STORED_KEY, 0)
    if why:
        print(f"caddy-acme: refusing what lego stored: {why}; nothing installed")
        return 2
    if same(STORED_CERT, CONF["cert"]) and key_current():
        if not os.path.exists(RELOAD_OWED):
            print("caddy-acme: the installed certificate is current")
            return 0
        print("caddy-acme: the installed certificate is current; an earlier reload failed, retrying")
    else:
        # Caddy reads the pair only on the reload below (or a start). A crash between the
        # two renames leaves a pair that differs from what lego stored: the next run installs
        # both again. A reload owed from an earlier run stays owed when this pair is rolled back:
        # the pair put back is the one that reload never loaded.
        owed_before = os.path.exists(RELOAD_OWED)
        with open(RELOAD_OWED, "w"):
            pass
        why, intact = install_pair()
        if why:
            if intact and not owed_before:  # a pair half put back keeps the reload owed
                os.unlink(RELOAD_OWED)
            print(f"caddy-acme: the new pair did not check out: {why}")
            return 2
        print(f"caddy-acme: installed a new certificate for {', '.join(CONF['domains'])}")
    clean = dict(os.environ)
    compose = ["docker", "compose", "-f", CONF["compose"]]
    # a Caddy that is not running (or not yet deployed: the first certificate is obtained before
    # Caddy starts) reads the new pair when it starts; only a running one is owed a reload
    if not os.path.exists(CONF["compose"]):
        print("caddy-acme: Caddy is not deployed yet; it reads the new certificate when it starts")
        os.unlink(RELOAD_OWED)
        return 0
    ps = subprocess.run([*compose, "ps", "--status", "running", "--quiet", "caddy"],
                        env=clean, capture_output=True, text=True, check=False)  # fmt: skip
    if ps.returncode != 0:
        print(f"caddy-acme: docker compose ps failed (exit {ps.returncode}); the reload is retried next run")
        return 3
    if not ps.stdout.strip():
        print("caddy-acme: Caddy is not running; it reads the new certificate when it starts")
        os.unlink(RELOAD_OWED)
        return 0
    r = subprocess.run([*compose, "exec", "-T", "caddy", "caddy", "reload", "--config", CONF["config"],
                        "--adapter", "caddyfile", "--force"], env=clean, check=False)  # fmt: skip
    if r.returncode != 0:
        print(f"caddy-acme: caddy reload failed (exit {r.returncode}); retried next run")
        return 3
    os.unlink(RELOAD_OWED)
    print("caddy-acme: reloaded Caddy (caddy reload --force; it now serves the new certificate)")
    return 0


def check():
    why = problem(CONF["cert"], CONF["key"], CONF["renew_days"])
    if not why and os.path.exists(RELOAD_OWED):
        why = "Caddy has not reloaded the installed certificate (a reload failed)"
    print(f"caddy-acme: {why}" if why else "caddy-acme: the installed certificate is valid")
    return 1 if why else 0


def main(argv):
    if argv not in ([], ["--check"]):
        print("usage: caddy-acme-renew [--check]")
        return 2
    try:
        return check() if argv else renew()
    except CannotMeasure as e:  # exit 1 would read as "invalid": the role would start the unit
        print(f"caddy-acme: {e}; nothing was checked or installed")
        return 100


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
