# {{ intel_ingest_marker }}, instance {{ intel_ingest_logical_id }}); local changes are overwritten.
# One incremental run: per type, page by page, each page checkpointed atomically before the next.
[Unit]
Description=intel-ingest {{ intel_ingest_logical_id }}: threat-intel indicators into the graph store
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ intel_ingest_user }}
Group={{ intel_ingest_group }}
EnvironmentFile={{ intel_ingest_env_file }}
EnvironmentFile={{ intel_ingest_login_env_file }}
ExecStart=/usr/bin/python3 {{ intel_ingest_script }}
# the script saves its checkpoint on SIGTERM and exits cleanly; give it time to finish the current page
KillSignal=SIGTERM
TimeoutStopSec=5min
# exit 2 is the script's DELIBERATE "paused at the cap or on a signal, resume next time": progress, not failure
SuccessExitStatus=2
Nice=10
{% if hnx_module_slice | default('') %}
Slice={{ hnx_module_slice }}
{% endif %}
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths={{ intel_ingest_state_dir }}
MemoryMax=1G
