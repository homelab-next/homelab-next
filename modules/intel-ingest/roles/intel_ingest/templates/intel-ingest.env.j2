# {{ intel_ingest_marker }}, instance {{ intel_ingest_logical_id }}); local changes are overwritten.
# No secret here: the platform key and the graph password are in credentials/login.env (root-only).
INGEST_SOURCE_URL={{ intel_ingest_threat_intel_url }}
INGEST_GRAPH_URL={{ intel_ingest_graph_url }}
INGEST_GRAPH_USER={{ intel_ingest_graph_user }}
INGEST_STATE_FILE={{ intel_ingest_state_file }}
INGEST_MAX_RUNTIME_SECONDS={{ intel_ingest_max_runtime_s | int }}
INGEST_CA_FILE={{ intel_ingest_ca_bundle_file }}
PYTHONUNBUFFERED=1
PYTHONSAFEPATH=1
PYTHONNOUSERSITE=1
