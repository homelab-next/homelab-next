# {{ honeypot_marker }}, instance {{ honeypot_logical_id }}); local changes are overwritten. No secret is in this file.
HNX_HP_BIND={{ honeypot_bind }}
HNX_HP_PORT={{ honeypot_port }}
HNX_HP_SPOOL={{ honeypot_spool_file }}
HNX_HP_MAX_LINE={{ honeypot_max_line_bytes }}
HNX_HP_SPOOL_MAX_BYTES={{ honeypot_spool_max_bytes }}
HNX_HP_STATE_DIR={{ honeypot_state_dir }}
HNX_HP_BATCH_ROWS={{ honeypot_batch_rows }}
HNX_ENDPOINT_LAKE_QUERY={{ honeypot_effective_lake_url }}
# the platform's lake client factory builds both lake clients; the catalog one is never called
HNX_ENDPOINT_LAKE_CATALOG={{ honeypot_effective_lake_url }}
HNX_HP_LAKE_USER={{ honeypot_lake_user }}
HNX_HP_LAKE_CATALOG={{ honeypot_lake_catalog }}
HNX_HP_LAKE_SCHEMA={{ honeypot_lake_schema }}
HNX_HP_LAKE_TABLE={{ honeypot_lake_table }}
{% if honeypot_lake_ca_ref != '' %}
HNX_HP_LAKE_CA_FILE={{ honeypot_ca_file }}
{% endif %}
HNX_HP_REPORT_DIR={{ honeypot_reports_dir }}
HNX_HP_SITE_LABEL={{ honeypot_site_label }}
HNX_HP_ENRICH={{ '1' if honeypot_enrich | bool else '0' }}
HNX_HP_FRIENDLY_IPS={{ honeypot_friendly_ips | join(',') }}
HNX_HP_CTI_TABLE={{ honeypot_cti_table }}
HNX_HP_LLM_URL={{ honeypot_effective_gateway_url }}
HNX_HP_LLM_MODEL={{ honeypot_gateway_model }}
HNX_HP_LLM_MAX_TOKENS={{ honeypot_llm_max_tokens }}
HNX_HP_LLM_TIMEOUT_S={{ honeypot_llm_timeout_s }}
HNX_HP_LLM_ATTEMPTS={{ honeypot_llm_attempts }}
HNX_HP_LLM_RETRY_SLEEP_S={{ honeypot_llm_retry_sleep_s }}
HNX_HP_LLM_TEMPERATURE={{ honeypot_llm_temperature }}
HNX_HP_REPORT_KEEP_DAYS={{ honeypot_report_keep_days }}
