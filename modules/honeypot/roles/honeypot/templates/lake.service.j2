# {{ honeypot_marker }}, instance {{ honeypot_logical_id }}); local changes are overwritten.
# Lands the spooled events in the lake's events table; the query-service password is a systemd
# credential (read by name from $CREDENTIALS_DIRECTORY), never an environment value.
[Unit]
Description=honeypot {{ honeypot_logical_id }} lands its events in the lake
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ honeypot_user }}
Group={{ honeypot_group }}
EnvironmentFile={{ honeypot_env_file }}
EnvironmentFile={{ honeypot_lake_login_env_file }}
# the timer's runs are reported to the shared last-run record (the writer runs privileged: +)
ExecStartPre=-+/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ honeypot_last_run_dir }} --group {{ honeypot_last_run_group }} --job timer:honeypot/lake --unit %n --calendar "{{ honeypot_lake_oncalendar }}" --delay 0
ExecStart=/usr/local/libexec/homelabnext/hnx-honeypot-lake land
Environment=PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1
Nice=10
ExecStopPost=-+/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ honeypot_last_run_dir }} --group {{ honeypot_last_run_group }} --job timer:honeypot/lake --unit %n --calendar "{{ honeypot_lake_oncalendar }}" --delay 0
TimeoutStartSec=3600
{% if hnx_module_slice | default('') %}
Slice={{ hnx_module_slice }}
{% endif %}
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths={{ honeypot_state_dir }}
ReadOnlyPaths={{ honeypot_spool_dir }}
MemoryMax=1G
