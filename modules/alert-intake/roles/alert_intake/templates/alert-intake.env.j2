# {{ alert_intake_marker }}, instance {{ alert_intake_logical_id }}); local changes are overwritten.
# No secret here: the tokens and the case store's key are in credentials/logins.env (root-only).
ALERT_INTAKE_LISTEN_HOST={{ alert_intake_listen_address }}
ALERT_INTAKE_LISTEN_PORT={{ alert_intake_port | int }}
ALERT_INTAKE_ALLOWED_SOURCE={{ alert_intake_allowed_source }}
ALERT_INTAKE_CASES_ADAPTER={{ alert_intake_cases_adapter }}
ALERT_INTAKE_CASES_CONFIG_FILE={{ alert_intake_cases_config_file }}
ALERT_INTAKE_ADAPTER_PATH={{ alert_intake_adapter_dir }}
ALERT_INTAKE_LIB_PATH={{ alert_intake_shared_dir }}
ALERT_INTAKE_NOTIFY_URL={{ alert_intake_notify_url }}
ALERT_INTAKE_NOTIFY_TOPIC={{ alert_intake_notify_topic }}
ALERT_INTAKE_NOTIFY_PLAINTEXT={{ 'true' if alert_intake_notify_plaintext | bool else 'false' }}
{% if alert_intake_notify_ca_ref != '' %}
ALERT_INTAKE_NOTIFY_CA_FILE={{ alert_intake_notify_ca_file }}
{% endif %}
ALERT_INTAKE_PAGE_MIN={{ alert_intake_page_min }}
ALERT_INTAKE_PROMOTE_MIN={{ alert_intake_promote_min }}
ALERT_INTAKE_CANARY_PREFIX={{ alert_intake_canary_prefix }}
ALERT_INTAKE_STATE_FILE={{ alert_intake_state_file }}
PYTHONUNBUFFERED=1
PYTHONSAFEPATH=1
PYTHONNOUSERSITE=1
