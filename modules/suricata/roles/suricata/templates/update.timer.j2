# Managed by Ansible (module suricata); do not edit. Calendar based and persistent (LL-041).
[Unit]
Description=Daily Suricata rule update

[Timer]
OnCalendar={{ suricata_update_oncalendar }}
RandomizedDelaySec={{ suricata_update_random_delay }}
Persistent=true

[Install]
WantedBy=timers.target
