# Managed by Ansible (module suricata); do not edit.
[Unit]
Description=Fetch the upstream Suricata rules and reload them
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ suricata_update_cli }} --suricata-conf {{ suricata_config_dir }}/{{ suricata_config_file }}
{% if suricata_reload | bool %}
ExecStartPost=-{{ suricata_suricatasc_cli }} -c reload-rules
{% endif %}
