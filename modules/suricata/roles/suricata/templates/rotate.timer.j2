# Managed by Ansible (module suricata); do not edit. Hourly, because the distribution's logrotate
# runs daily and a busy sensor can fill a disk in less (LL-145).
[Unit]
Description=Hourly size check of the Suricata eve logs

[Timer]
OnCalendar=*:07:00
Persistent=true

[Install]
WantedBy=timers.target
