# Managed by homelabnext (role prometheus); local changes are overwritten.
# The role's own SNMP module beside the exporter's bundled ones (if_mib, system, ...). nas_storage: a
# storage appliance's disk, fan and volume tables from the vendor tree its firmware serves (read live:
# disks .3.11.1, fans .3.15.1, volumes .3.17.1, numeric values; the SMART and volume words become 1/0).
# The community is in a file of its own (the credentials directory), never here.
modules:
  nas_storage:
    walk:
      - 1.3.6.1.4.1.24681.1.3.11.1
      - 1.3.6.1.4.1.24681.1.3.15.1
      - 1.3.6.1.4.1.24681.1.3.17.1
    metrics:
      - name: nas_disk_temperature_celsius
        oid: 1.3.6.1.4.1.24681.1.3.11.1.3
        type: gauge
        help: disk temperature
        indexes: [{labelname: disk, type: gauge}]
        lookups: [{labels: [disk], labelname: disk_name, oid: 1.3.6.1.4.1.24681.1.3.11.1.2, type: DisplayString}]
      - name: nas_disk_status
        oid: 1.3.6.1.4.1.24681.1.3.11.1.4
        type: gauge
        help: disk status (0 ready; negative is no disk, invalid, a read/write error or unknown)
        indexes: [{labelname: disk, type: gauge}]
        lookups: [{labels: [disk], labelname: disk_name, oid: 1.3.6.1.4.1.24681.1.3.11.1.2, type: DisplayString}]
      - name: nas_disk_smart
        oid: 1.3.6.1.4.1.24681.1.3.11.1.7
        type: DisplayString
        help: disk SMART summary (1 good, 0 anything else)
        indexes: [{labelname: disk, type: gauge}]
        lookups: [{labels: [disk], labelname: disk_name, oid: 1.3.6.1.4.1.24681.1.3.11.1.2, type: DisplayString}]
        regex_extracts:
          _good:
            - {regex: '^(?i:good)$', value: '1'}
            - {regex: '.*', value: '0'}
      - name: nas_fan_rpm
        oid: 1.3.6.1.4.1.24681.1.3.15.1.3
        type: gauge
        help: fan speed
        indexes: [{labelname: fan, type: gauge}]
        lookups: [{labels: [fan], labelname: fan_name, oid: 1.3.6.1.4.1.24681.1.3.15.1.2, type: DisplayString}]
      - name: nas_volume_size_kilobytes
        oid: 1.3.6.1.4.1.24681.1.3.17.1.4
        type: gauge
        help: volume size
        indexes: [{labelname: volume, type: gauge}]
        lookups: [{labels: [volume], labelname: volume_name, oid: 1.3.6.1.4.1.24681.1.3.17.1.2, type: DisplayString}]
      - name: nas_volume_free_kilobytes
        oid: 1.3.6.1.4.1.24681.1.3.17.1.5
        type: gauge
        help: volume free space
        indexes: [{labelname: volume, type: gauge}]
        lookups: [{labels: [volume], labelname: volume_name, oid: 1.3.6.1.4.1.24681.1.3.17.1.2, type: DisplayString}]
      - name: nas_volume_status
        oid: 1.3.6.1.4.1.24681.1.3.17.1.6
        type: DisplayString
        help: volume status (1 ready, 0 anything else)
        indexes: [{labelname: volume, type: gauge}]
        lookups: [{labels: [volume], labelname: volume_name, oid: 1.3.6.1.4.1.24681.1.3.17.1.2, type: DisplayString}]
        regex_extracts:
          _ready:
            - {regex: '^(?i:ready)$', value: '1'}
            - {regex: '.*', value: '0'}
