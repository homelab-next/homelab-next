# Managed by homelabnext (role prometheus); local changes are overwritten.
# The default alert rules: a scrape target down, a full disk, a filesystem gone read-only and a
# host short of memory. The forwarder posts what fires to the notify service.
groups:
  - name: hnx-default
    rules:
      # always firing: proof that the rules are loaded and evaluated. The forwarder never posts it;
      # it sends the dead-man heartbeat only while this fires (prometheus_heartbeat_topic).
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "always firing: the alert rules are loaded and evaluated"
      - alert: TargetDown
        expr: up == 0
        for: {{ prometheus_alert_target_down_for }}
        labels:
          severity: critical
        annotations:
{% raw %}
          summary: "{{ $labels.job }} target {{ $labels.instance }} has been unreachable"
{% endraw %}
      - alert: NoTargets
        expr: absent(up{job="node"})
        for: {{ prometheus_alert_target_down_for }}
        labels:
          severity: critical
        annotations:
          summary: "no host target is being scraped: the generated target list is empty or was not loaded"
      - alert: DiskAlmostFull
        expr: (1 - node_filesystem_avail_bytes / node_filesystem_size_bytes) * 100 > {{ prometheus_alert_disk_used_percent | int }} and node_filesystem_size_bytes > 0
        for: {{ prometheus_alert_disk_for }}
        labels:
          severity: warning
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} {{ $labels.mountpoint }} is over {% endraw %}{{ prometheus_alert_disk_used_percent | int }}{% raw %}% full"
{% endraw %}
      - alert: FilesystemReadOnly
        expr: node_filesystem_readonly{% if prometheus_alert_readonly_ignore != '' %}{mountpoint!~"{{ prometheus_alert_readonly_ignore }}"}{% endif %} == 1
        for: {{ prometheus_alert_readonly_for }}
        labels:
          severity: critical
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} {{ $labels.mountpoint }} is mounted read-only"
{% endraw %}
      - alert: MemoryPressure
        expr: node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100 < {{ prometheus_alert_memory_available_percent | int }}
        for: {{ prometheus_alert_memory_for }}
        labels:
          severity: warning
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} has under {% endraw %}{{ prometheus_alert_memory_available_percent | int }}{% raw %}% of its memory available"
{% endraw %}
      # UPS protection (control ups-protection, role nut_ups): the textfile metrics of a host with a USB UPS.
      # A host with no UPS exposes none of these, so none of them fires there.
      - alert: UpsOnBattery
        expr: nut_ups_on_battery == 1
        for: 1m
        labels:
          severity: critical
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} is running on UPS battery (mains lost); a clean shutdown follows at low battery"
{% endraw %}
      - alert: UpsLowBattery
        expr: nut_ups_low_battery == 1
        labels:
          severity: critical
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} UPS reports low battery: the host is shutting down"
{% endraw %}
      - alert: UpsMonitorDown
        expr: nut_monitor_active == 0
        for: 5m
        labels:
          severity: critical
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} nut-monitor (the UPS shutdown controller) is not running: no automatic shutdown on power loss"
{% endraw %}
      - alert: UpsUnreadable
        expr: nut_ups_up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} the UPS does not answer (driver or USB cable)"
{% endraw %}
      - alert: UpsCheckStale
        expr: time() - nut_ups_check_timestamp_seconds > 300
        for: 5m
        labels:
          severity: warning
        annotations:
{% raw %}
          summary: "{{ $labels.instance }} the UPS check has not written metrics for over 5 minutes"
{% endraw %}
{% if prometheus_probes_enabled | bool %}
  - name: hnx-probes
    rules:
      # an HTTP(S) probe (the blackbox exporter, one per published service) failed for the whole window
      - alert: ProbeDown
        expr: probe_success == 0
        for: {{ prometheus_alert_probe_down_for }}
        labels:
          severity: critical
        annotations:
{% raw %}
          summary: "{{ $labels.service }} is down: the probe of {{ $labels.instance }} has failed"
{% endraw %}
{% endif %}
