# {{ lab_checks_marker }}, instance {{ lab_checks_logical_id }}); local changes are overwritten.
# One run of the site's register: every criterion, the results document, and a page for each NEWLY red one.
[Unit]
Description=lab-checks {{ lab_checks_logical_id }}: run the invariants register and page what is newly broken
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# the timer's runs are reported to the shared last-run record (the writer runs privileged: +)
ExecStartPre=-+/usr/local/libexec/homelabnext/hnx-last-run start --dir {{ lab_checks_last_run_dir }} --group {{ lab_checks_last_run_group }} --job timer:lab_checks/{{ lab_checks_logical_id }} --unit %n --calendar "{{ lab_checks_oncalendar }}" --delay 0
ExecStart=/opt/hnx/bin/hnx invariants run {{ lab_checks_register_file }} --root {{ lab_checks_data_root }} --out {{ lab_checks_results_file }} --state {{ lab_checks_state_file }} --notify-cmd "{{ lab_checks_notify_script }} --config {{ lab_checks_notify_config }}" --notify-ceiling {{ lab_checks_notify_ceiling }}
# the runner exits 1 when a criterion is red and 100 when one could not be measured: the page is the signal, and the
# unit itself did its job (a failed unit would also hide a real fault of the runner behind a standing red)
SuccessExitStatus=1 100
ExecStopPost=-+/usr/local/libexec/homelabnext/hnx-last-run finish --dir {{ lab_checks_last_run_dir }} --group {{ lab_checks_last_run_group }} --job timer:lab_checks/{{ lab_checks_logical_id }} --unit %n --calendar "{{ lab_checks_oncalendar }}" --delay 0
TimeoutStartSec={{ lab_checks_max_runtime_s }}
Nice=10
{% if hnx_module_slice | default('') %}
Slice={{ hnx_module_slice }}
{% endif %}
# root, because a criterion may read what an unprivileged account owns (a lane's run records); it is hardened instead:
# no new privileges, one capability, a read-only system, writes only to its own results and state
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths={{ lab_checks_results_dir }} {{ lab_checks_state_dir }}
MemoryMax=1G
