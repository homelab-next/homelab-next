{% set job = cti_pipeline_jobs[item.job] %}
{% set lane_root = cti_pipeline_data_root ~ '/' ~ item.lane %}
{% set lane_refs = (cti_pipeline_lane_refs[item.lane] | default({})).keys() | list | sort %}
{% set placeholders = {'app': cti_pipeline_current ~ '/app',
                       'python': cti_pipeline_current ~ '/venv/bin/python',
                       'lane_root': lane_root,
                       'config': cti_pipeline_config_dir} %}
{% if cti_pipeline_lake_ca_ref != '' %}
{% set _ = placeholders.update({'lake_ca': cti_pipeline_lake_ca_file}) %}
{% endif %}
{{ {'version': 1,
    'managed_by': cti_pipeline_marker ~ ', service ' ~ cti_pipeline_logical_id ~ ')',
    'set': cti_pipeline_logical_id,
    'job': item.job,
    'lane': item.lane,
    'instance': item.instance,
    'lane_root': lane_root,
    'runs_dir': lane_root ~ '/' ~ cti_pipeline_runs_subdir,
    'steps': job.steps,
    'env': (cti_pipeline_env[item.lane] | default({})) | combine(job.env | default({})),
    'forced_env': {cti_pipeline_lake_schema_env: cti_pipeline_lake_schema[item.lane],
                   cti_pipeline_publish_mode_env: cti_pipeline_stage_mode},
    'lake_schema_env': cti_pipeline_lake_schema_env,
    'publish_mode_env': cti_pipeline_publish_mode_env,
    'credentials': (job.refs | sort) if job.refs is defined else lane_refs,
    'placeholders': placeholders} | to_nice_json }}
