# {{ ci_runner_marker }}, instance {{ ci_runner_logical_id }}); local changes are overwritten.
# The job VMs use user-mode networking: every packet they send leaves this host as a socket of
# {{ ci_runner_user }}. That user may reach the resolvers on port 53 and public addresses on the
# listed ports, nothing else: no private, shared, loopback (the VMs' gateway is this host's
# loopback), link-local or multicast address, and no IPv6. Only this table is replaced.
table inet {{ ci_runner_egress_table }}
delete table inet {{ ci_runner_egress_table }}
table inet {{ ci_runner_egress_table }} {
	set resolvers4 {
		type ipv4_addr
		elements = { {{ ci_runner_resolvers | join(', ') }} }
	}
	set refused4 {
		type ipv4_addr
		flags interval
		elements = { {{ ci_runner_refused_v4 | join(', ') }} }
	}
	chain output {
		type filter hook output priority filter - 5; policy accept;
		meta skuid != "{{ ci_runner_user }}" accept
		ct state established,related accept
		meta nfproto ipv6 counter drop comment "hnx-ci-no-ipv6"
		ip daddr @resolvers4 meta l4proto { tcp, udp } th dport 53 accept comment "hnx-ci-dns"
		ip daddr @refused4 limit rate 6/minute burst 6 packets log prefix "hnx-ci-refused: " level warn
		ip daddr @refused4 counter drop comment "hnx-ci-refused-destination"
		tcp dport { {{ ci_runner_egress_tcp_ports | join(', ') }} } accept comment "hnx-ci-internet-tcp"
		udp dport { {{ ci_runner_egress_udp_ports | join(', ') }} } accept comment "hnx-ci-internet-udp"
		counter drop comment "hnx-ci-default-deny"
	}
}
