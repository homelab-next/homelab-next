{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "client": {
    "enforce_auth_on_inference": true,
    "drop_excess_requests": false,
    "disable_content_logging": true
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": false
  },
  "framework": {
    "pricing": {
      "pricing_url": "file:///app/data/pricing.json",
      "model_parameters_url": "file:///app/data/model-parameters.json",
      "mcp_library_sync_interval": 0
    }
  },
  "providers": {
    "hnx-inference-large": {
      "keys": [
        {
          "id": "hnx-inference-large-key",
          "name": "hnx-inference-large-key",
          "value": "no-key",
          "models": [
            "main-reasoner"
          ],
          "aliases": {
            "main-reasoner": "example-27b"
          },
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://inference-large.svc.example.internal:8000",
        "default_request_timeout_in_seconds": 120
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "hnx-inference-small": {
      "keys": [
        {
          "id": "hnx-inference-small-key",
          "name": "hnx-inference-small-key",
          "value": "no-key",
          "models": [
            "fast-classifier"
          ],
          "aliases": {
            "fast-classifier": "example-4b"
          },
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://inference-small.svc.example.internal:8000",
        "default_request_timeout_in_seconds": 120
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  },
  "governance": {
    "rate_limits": [
      {
        "id": "rl-role-fast-classifier",
        "request_max_limit": 600,
        "request_reset_duration": "1m",
        "token_max_limit": 200000,
        "token_reset_duration": "1m"
      },
      {
        "id": "rl-key-conformance-throttle",
        "request_max_limit": 3,
        "request_reset_duration": "1m"
      }
    ],
    "budgets": [
      {
        "id": "budget-role-fast-classifier",
        "max_limit": 1.5,
        "reset_duration": "1m"
      }
    ],
    "model_configs": [
      {
        "id": "mc-fast-classifier",
        "model_name": "fast-classifier",
        "scope": "global",
        "rate_limit_id": "rl-role-fast-classifier",
        "budget_id": "budget-role-fast-classifier"
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-gateway-admin",
        "name": "gateway-admin",
        "value": "env.HNX_SECRET_LLM_GATEWAY_MASTER_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "hnx-inference-large",
            "allowed_models": [
              "main-reasoner"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "hnx-inference-small",
            "allowed_models": [
              "fast-classifier"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-agent-reader",
        "name": "agent-reader",
        "value": "env.HNX_SECRET_LLM_GATEWAY_KEY_READER",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "hnx-inference-small",
            "allowed_models": [
              "fast-classifier"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-agent-responder",
        "name": "agent-responder",
        "value": "env.HNX_SECRET_LLM_GATEWAY_KEY_RESPONDER",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "hnx-inference-large",
            "allowed_models": [
              "main-reasoner"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          },
          {
            "provider": "hnx-inference-small",
            "allowed_models": [
              "fast-classifier"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-conformance-throttle",
        "name": "conformance-throttle",
        "value": "env.HNX_SECRET_LLM_GATEWAY_KEY_CONFORMANCE_THROTTLE",
        "is_active": true,
        "rate_limit_id": "rl-key-conformance-throttle",
        "provider_configs": [
          {
            "provider": "hnx-inference-small",
            "allowed_models": [
              "fast-classifier"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1.0
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "route-main-reasoner",
        "name": "mdl:main-reasoner bindings in priority order, then its fallback chain",
        "cel_expression": "model == 'main-reasoner'",
        "targets": [
          {
            "provider": "hnx-inference-large",
            "model": "main-reasoner",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "hnx-inference-small/fast-classifier"
        ]
      }
    ],
    "auth_config": {
      "admin_username": "admin",
      "admin_password": "env.HNX_SECRET_LLM_GATEWAY_BIFROST_ADMIN_PASSWORD",
      "is_enabled": true
    }
  }
}
