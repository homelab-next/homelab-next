{
  "coalesce": {
    "key": "$event.data.agent_key",
    "window_s": 600
  },
  "digest": "sha256:c62c6e720a67efe6f06966063c7b610e978c73f3d3a0d21e46b76a2aa43982ce",
  "mode": "shadow",
  "pack": {
    "actor": "profile:workflow-agents",
    "broker_manifest": "workflows/broker.manifest.json",
    "description": "Resubmit an agent job once, at lower priority, when it failed for an environment reason.",
    "fixtures": [
      {
        "event": {
          "data": {
            "agent_key": "triage",
            "attempts": 2,
            "failure_class": "capacity",
            "reason": "capacity",
            "resubmits": 0,
            "run_id": "run-0001",
            "state": "failed"
          },
          "id": "evt-job-0001",
          "source": "svc:llm-orchestrator",
          "specversion": "1.0",
          "subject": "run-0001",
          "time": "2026-01-01T00:00:00Z",
          "type": "homelabnext.agent.job.failed"
        },
        "expect": {
          "calls": [
            {
              "action": "agent.job.submit",
              "params": {
                "agent_key": "triage",
                "idempotency_key": "evt-job-0001",
                "priority": 90,
                "reason": "capacity",
                "retry_of_run_id": "run-0001"
              },
              "result": "executed",
              "target": "svc:orchestration"
            }
          ]
        },
        "name": "capacity-failure-resubmitted"
      },
      {
        "event": {
          "data": {
            "agent_key": "triage",
            "attempts": 2,
            "failure_class": "capacity",
            "reason": "capacity",
            "resubmits": 1,
            "retry_of_run_id": "run-0001",
            "run_id": "run-0002",
            "state": "failed"
          },
          "id": "evt-job-0002",
          "source": "svc:llm-orchestrator",
          "specversion": "1.0",
          "subject": "run-0002",
          "time": "2026-01-01T00:20:00Z",
          "type": "homelabnext.agent.job.failed"
        },
        "expect": {
          "calls": [],
          "triggered": false
        },
        "name": "resubmitted-job-not-retried-again"
      },
      {
        "event": {
          "data": {
            "agent_key": "triage",
            "attempts": 1,
            "failure_class": "deadline",
            "reason": "deadline",
            "resubmits": 0,
            "run_id": "run-0003",
            "state": "failed"
          },
          "id": "evt-job-0003",
          "source": "svc:llm-orchestrator",
          "specversion": "1.0",
          "subject": "run-0003",
          "time": "2026-01-01T00:30:00Z",
          "type": "homelabnext.agent.job.failed"
        },
        "expect": {
          "calls": [],
          "triggered": false
        },
        "name": "deadline-not-retried"
      },
      {
        "event": {
          "data": {
            "agent_key": "triage",
            "attempts": 1,
            "failure_class": "stall",
            "reason": "stall",
            "resubmits": 0,
            "retried_by_run_id": "run-0005",
            "run_id": "run-0004",
            "state": "failed"
          },
          "id": "evt-job-0004",
          "source": "svc:llm-orchestrator",
          "specversion": "1.0",
          "subject": "run-0004",
          "time": "2026-01-01T00:40:00Z",
          "type": "homelabnext.agent.job.failed"
        },
        "expect": {
          "calls": [],
          "triggered": false
        },
        "name": "already-resubmitted-not-retried-again"
      }
    ],
    "pack": "agent-job-retry",
    "steps": [
      {
        "action": "agent.job.submit",
        "id": "resubmit",
        "kind": "action",
        "params": {
          "agent_key": "$event.data.agent_key",
          "idempotency_key": "$event.id",
          "priority": 90,
          "reason": "$event.data.reason",
          "retry_of_run_id": "$event.data.run_id"
        },
        "target": "svc:orchestration"
      }
    ],
    "trigger": {
      "event": "homelabnext.agent.job.failed",
      "where": [
        {
          "equals": "svc:llm-orchestrator",
          "ref": "$event.source"
        },
        {
          "in": [
            "capacity",
            "stall",
            "timeout",
            "backend-down"
          ],
          "ref": "$event.data.reason"
        },
        {
          "in": [
            0
          ],
          "ref": "$event.data.resubmits"
        },
        {
          "exists": false,
          "ref": "$event.data.retried_by_run_id"
        }
      ]
    },
    "version": 1
  },
  "risky": {
    "resubmit": false
  }
}
