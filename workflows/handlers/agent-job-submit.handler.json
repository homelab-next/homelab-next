{
  "action": "agent.job.submit",
  "audit": true,
  "description": "Put one agent job on the orchestration controller's queue (POST /jobs); the controller admits it against live load.",
  "handler": "handlers/agent-job-submit.sh",
  "handler_digest": "sha256:62a9a5c7ffcddfd2a09e3956d4f562c80e8ceb02bfb83486b9573919f9ed7c5b",
  "idempotent": true,
  "max_output_bytes": 65536,
  "params_schema": {
    "additionalProperties": false,
    "properties": {
      "agent_key": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
        "type": "string"
      },
      "idempotency_key": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$",
        "description": "also sent as the Idempotency-Key header; for a resubmit, the failed run's id"
      },
      "priority": {
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "reason": {
        "maxLength": 64,
        "type": "string",
        "description": "only with retry_of_run_id: the failure class the controller recorded for that run"
      },
      "retry_of_run_id": {
        "type": "string",
        "description": "a resubmit: the controller replays that run's payload, so it carries no task_description",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
      },
      "task_description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "not": {
          "pattern": "\\{\\{|\\{%|<%|%>"
        },
        "description": "the job's task (the controller takes no input object); never a template marker"
      }
    },
    "required": [
      "agent_key",
      "idempotency_key",
      "priority"
    ],
    "type": "object",
    "dependentRequired": {
      "reason": [
        "retry_of_run_id"
      ]
    },
    "dependentSchemas": {
      "retry_of_run_id": {
        "not": {
          "required": [
            "task_description"
          ]
        }
      }
    }
  },
  "requires_approval": false,
  "secrets": [
    "ORCHESTRATOR_JOBS_URL"
  ],
  "tier": "write",
  "timeout_s": 30
}
