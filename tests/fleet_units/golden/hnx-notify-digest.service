# Managed by fleet_units. Do not edit.
[Unit]
Description=Send the daily digest
OnFailure=hnx-page@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/notify-digest --daily
User=svc-notify
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
