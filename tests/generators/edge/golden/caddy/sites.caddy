# generated by hnx (homelabnext) from services.yml sha256:f865496fba73b7b4; do not edit

(hnx_forward_auth) {
	handle /oauth2/* {
		reverse_proxy http://auth-proxy.svc.example.internal:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	route {
		# client-sent identity headers never reach the service, whatever the auth proxy answers
		request_header -*auth-request*
		request_header -*auth_request*
		forward_auth http://auth-proxy.svc.example.internal:4180 {
			uri /oauth2/auth?allowed_groups={args[0]}
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-User X-Auth-Request-Groups X-Auth-Request-Email X-Auth-Request-Preferred-Username
			@hnx_sign_in status 401
			handle_response @hnx_sign_in {
				redir * /oauth2/sign_in?rd={scheme}://{host}{http.request.uri_escaped}
			}
		}
	}
}

(hnx_strip_foreign_identity) {
	request_header -*forwarded-user*
	request_header -*forwarded_user*
	request_header -*forwarded-groups*
	request_header -*forwarded_groups*
	request_header -*forwarded-email*
	request_header -*forwarded_email*
	request_header -*forwarded-preferred-username*
	request_header -*forwarded-preferred_username*
	request_header -*forwarded_preferred-username*
	request_header -*forwarded_preferred_username*
	request_header -*forwarded-access-token*
	request_header -*forwarded-access_token*
	request_header -*forwarded_access-token*
	request_header -*forwarded_access_token*
	request_header -*remote-user*
	request_header -*remote_user*
	request_header -*remote-groups*
	request_header -*remote_groups*
	request_header -*remote-email*
	request_header -*remote_email*
	request_header -*remote-name*
	request_header -*remote_name*
	request_header -*webauth-user*
	request_header -*webauth_user*
}

sso.example.internal {
	# service idp (idp) owner=identity-team
	request_header -*auth-request*
	request_header -*auth_request*
	import hnx_strip_foreign_identity
	reverse_proxy https://idp.svc.example.internal:8443 {
		transport http {
			tls
			tls_trust_pool file /etc/hnx/edge-tls/pki/internal-ca.pem
			tls_server_name idp.svc.example.internal
		}
	}
}

hub.example.internal {
	# service status-hub (status-hub) owner=platform-team
	request_header -*auth-request*
	request_header -*auth_request*
	import hnx_strip_foreign_identity
	import hnx_forward_auth lab-admins,lab-approvers
	reverse_proxy https://status-hub.svc.example.internal:8099 {
		header_up X-Hnx-Front-Door {env.HNX_SECRET_STATUS_FRONT_DOOR_SECRET}
		transport http {
			tls
			tls_client_auth /etc/hnx/edge-tls/edge/hub-client-cert.pem /etc/hnx/edge-tls/edge/hub-client-key.pem
			tls_trust_pool file /etc/hnx/edge-tls/pki/internal-ca.pem
			tls_server_name status-hub.svc.example.internal
		}
	}
}
