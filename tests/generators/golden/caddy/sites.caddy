# generated by hnx (homelabnext) from services.yml sha256:5a210420bb5c5f60; do not edit

(hnx_forward_auth) {
	route {
		# client-sent identity headers never reach the service, whatever the IdP answers
		request_header -*authentik*
		forward_auth https://idp.svc.example.internal:9443 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups
		}
	}
}

dashboards.lab.example {
	# service dashboards (dashboards) owner=platform-team
	import hnx_forward_auth
	reverse_proxy http://dashboards.svc.example.internal:3000
}

login.lab.example {
	# service idp (idp) owner=identity-team
	reverse_proxy https://idp.svc.example.internal:9443
}

status.lab.example {
	# service status-hub (status-hub) owner=platform-team
	import hnx_forward_auth
	reverse_proxy http://status-hub.svc.example.internal:8099 {
		header_up X-Hnx-Front-Door {env.HNX_SECRET_STATUS_FRONT_DOOR_SECRET}
	}
}
