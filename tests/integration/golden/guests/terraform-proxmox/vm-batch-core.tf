# generated by hnx guests render; do not edit
resource "proxmox_virtual_environment_vm" "batch_core" {
  name      = "batch-core"
  node_name = "hv-a"
  vm_id     = 141
  tags      = ["prod"]
  on_boot   = true

  clone {
    vm_id = var.vm_templates["debian-12-cloudinit"]
  }

  agent {
    enabled = true
  }

  cpu {
    cores = 2
    type  = "host"
  }

  memory {
    dedicated = 4096
  }

  disk {
    datastore_id = var.pools["fast"]
    interface    = "scsi0"
    size         = 24
    file_format  = "raw"
    discard      = "on"
  }

  network_device {
    bridge   = var.default_bridge
    vlan_id  = 30
    firewall = true
  }

  operating_system {
    type = "l26"
  }

  initialization {
    ip_config {
      ipv4 {
        address = "192.0.2.141/26"
        gateway = "192.0.2.129"
      }
    }
    user_account {
      username = "ansible"
      keys     = [var.ssh_keys["operator"]]
    }
  }
}
