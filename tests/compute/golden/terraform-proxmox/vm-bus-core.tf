# generated by hnx guests render; do not edit
resource "proxmox_virtual_environment_vm" "bus_core" {
  name      = "bus-core"
  node_name = "hv-a"
  vm_id     = 50
  tags      = ["legacy-net", "prod"]
  on_boot   = false

  clone {
    vm_id = var.vm_templates["debian-12-cloudinit"]
  }

  agent {
    enabled = true
  }

  cpu {
    cores = 2
    type  = "host"
  }

  memory {
    dedicated = 4096
    floating  = 2048
  }

  disk {
    datastore_id = var.pools["fast"]
    interface    = "scsi0"
    size         = 32
    file_format  = "qcow2"
    discard      = "on"
  }

  network_device {
    bridge = "${var.default_bridge}v20"
  }

  operating_system {
    type = "l26"
  }

  initialization {
    ip_config {
      ipv4 {
        address = "198.51.100.50/25"
        gateway = "198.51.100.1"
      }
    }
    user_account {
      username = "ansible"
      keys     = [var.ssh_keys["operator"]]
    }
  }

  lifecycle {
    ignore_changes = [clone, operating_system]
  }
}
