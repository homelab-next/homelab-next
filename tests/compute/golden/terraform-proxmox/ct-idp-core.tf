# generated by hnx guests render; do not edit
resource "proxmox_virtual_environment_container" "idp_core" {
  node_name     = "hv-a"
  vm_id         = 130
  tags          = ["identity", "prod"]
  start_on_boot = true
  unprivileged  = true

  operating_system {
    template_file_id = var.ct_templates["debian-12-lxc"]
    type             = "debian"
  }

  cpu {
    cores = 2
  }

  memory {
    dedicated = 2048
  }

  disk {
    datastore_id = var.pools["fast"]
    size         = 16
  }

  mount_point {
    volume    = "/tank/idp-media"
    path      = "/data/media"
    read_only = true
  }

  network_interface {
    name     = "eth0"
    bridge   = var.default_bridge
    vlan_id  = 10
    firewall = true
  }

  initialization {
    hostname = "idp-core"
    ip_config {
      ipv4 {
        address = "192.0.2.30/24"
        gateway = "192.0.2.1"
      }
    }
    user_account {
      keys = [var.ssh_keys["operator"]]
    }
  }
}
