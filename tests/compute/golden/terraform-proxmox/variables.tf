# generated by hnx guests render; do not edit
variable "proxmox_endpoint" {
  type        = string
  description = "API endpoint of the hypervisor cluster (supplied by the environment)."
}

variable "proxmox_api_token" {
  type        = string
  sensitive   = true
  ephemeral   = true
  description = "API token (TF_VAR_proxmox_api_token): ephemeral, so never in a saved plan or state."
}

variable "default_bridge" {
  type        = string
  description = "Bridge used by guests whose network.bridge is 'default'."
}

variable "pools" {
  type        = map(string)
  description = "Logical storage pool id -> datastore id."
}

variable "vm_templates" {
  type        = map(number)
  description = "Logical image name -> template vm id."
}

variable "ct_templates" {
  type        = map(string)
  description = "Logical image name -> container template file id."
}

variable "ssh_keys" {
  type        = map(string)
  sensitive   = true
  description = "Key name -> public key line."
}

variable "cloudinit_user_data" {
  type        = map(string)
  default     = {}
  description = "Guest name -> snippet file id (datastore:snippets/file) holding the cloudinit target's user-data; needed by every VM whose cloudinit sets sudo or packages (USER_DATA.md)."

  validation {
    condition     = length(setsubtract(["bus-core", "edge-core", "lake-core"], keys(var.cloudinit_user_data))) == 0
    error_message = "cloudinit_user_data needs a snippet file id for each of bus-core, edge-core, lake-core (USER_DATA.md)."
  }
}
