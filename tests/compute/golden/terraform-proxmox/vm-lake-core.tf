# generated by hnx guests render; do not edit
resource "proxmox_virtual_environment_vm" "lake_core" {
  name      = "lake-core"
  node_name = "hv-a"
  vm_id     = 40
  tags      = ["prod", "stateful"]
  on_boot   = true

  clone {
    vm_id = var.vm_templates["debian-12-cloudinit"]
  }

  agent {
    enabled = true
  }

  cpu {
    cores = 4
    type  = "host"
  }

  memory {
    dedicated = 16384
  }

  disk {
    datastore_id = var.pools["fast"]
    interface    = "scsi0"
    size         = 20
    file_format  = "raw"
    discard      = "on"
  }

  disk {
    datastore_id = var.pools["bulk"]
    interface    = "scsi1"
    size         = 200
    file_format  = "raw"
    discard      = "on"
  }

  network_device {
    bridge   = var.default_bridge
    vlan_id  = 20
    firewall = true
  }

  operating_system {
    type = "l26"
  }

  initialization {
    datastore_id = var.pools["fast"]
    ip_config {
      ipv4 {
        address = "198.51.100.40/25"
        gateway = "198.51.100.1"
      }
    }
    user_account {
      username = "ansible"
      keys     = [var.ssh_keys["operator"], var.ssh_keys["automation"]]
    }
  }

  lifecycle {
    ignore_changes = [clone]
  }
}
