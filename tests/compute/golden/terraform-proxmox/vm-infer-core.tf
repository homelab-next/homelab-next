# generated by hnx guests render; do not edit
resource "proxmox_virtual_environment_vm" "infer_core" {
  name      = "infer-core"
  node_name = "hv-a"
  vm_id     = 230
  tags      = ["gpu", "prod"]
  on_boot   = true
  bios      = "ovmf"
  machine   = "q35"

  clone {
    vm_id = var.vm_templates["debian-12-cloudinit"]
  }

  agent {
    enabled = true
  }

  cpu {
    cores = 16
    type  = "host"
  }

  memory {
    dedicated = 65536
  }

  disk {
    datastore_id = var.pools["fast"]
    interface    = "scsi0"
    size         = 40
    file_format  = "raw"
    discard      = "on"
  }

  disk {
    datastore_id = var.pools["bulk"]
    interface    = "scsi1"
    size         = 500
    file_format  = "raw"
    discard      = "on"
  }

  network_device {
    bridge   = var.default_bridge
    vlan_id  = 30
    firewall = true
  }

  operating_system {
    type = "l26"
  }

  hostpci {
    device  = "hostpci0"
    mapping = "gpu-a"
    pcie    = true
  }

  initialization {
    ip_config {
      ipv4 {
        address = "198.51.100.130/25"
        gateway = "198.51.100.129"
      }
    }
    user_account {
      username = "ansible"
      keys     = [var.ssh_keys["operator"]]
    }
  }
}
